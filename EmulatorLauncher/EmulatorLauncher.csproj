    </Page>
  </ItemGroup>
  <ItemGroup>
    <Page Update="Controls\SortOverlay.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Assets\Sound\BGM\" />
  </ItemGroup>

  <!--
    発行(publish)の出力に、リソース索引(RetroNexus.pri)が入らないことがある(未パッケージのWinUIアプリ)。
    これが無いと、起動時に「Cannot locate resource from 'ms-appx:///MainWindow.xaml'」で落ちるため、
    発行の最後に、ビルド出力のpriを発行先へコピーする。
  -->
  <Target Name="CopyPriToPublish" AfterTargets="Publish">
    <Copy SourceFiles="$(OutDir)$(TargetName).pri" DestinationFolder="$(PublishDir)" Condition="Exists('$(OutDir)$(TargetName).pri')" />
  </Target>

</Project>