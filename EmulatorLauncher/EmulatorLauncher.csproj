<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>EmulatorLauncher</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- exe(エクスプローラー/タスクバーのピン留め)のアイコン。ウィンドウ左上・タスクバーはMainWindowがAppWindow.SetIconで設定する。 -->
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>

    <!--
      プログラム名(製品名)。AssemblyNameが実際に生成される実行ファイル名
      (RetroNexus.exe)になり、Product/AssemblyTitleはエクスプローラーの
      「詳細」タブ等、ファイルのプロパティに表示される名前になる。
      内部のC#名前空間(RootNamespace)やプロジェクト/フォルダ名は
      EmulatorLauncherのままにしてある(変更範囲が非常に大きく、
      ビルド確認ができない環境でのリスクが高いため)。
    -->
    <AssemblyName>RetroNexus</AssemblyName>
    <Product>RetroNexus</Product>
    <!-- 設定→アプリ情報に表示されるバージョン(AssemblyInformationalVersion) -->
    <Version>1.0.0-rc.1</Version>
    <!--
      NuGetパッケージ(Microsoft.Data.Sqlite等)が持つ多言語のリソース(cs/de/es/fr/ja/ko/…フォルダ)を
      出力へコピーしない。中身はライブラリ自身の例外メッセージの翻訳だけで、このアプリの表示には使わない。
      英語(既定)のメッセージだけになるので、不具合のログを検索するときにも都合がよい。
    -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AssemblyTitle>RetroNexus</AssemblyTitle>

    <!--
      x64固定。emulator側(旧LibretroVC)が前提とするSDL3.dllおよびlibretroコア(.dll)は
      いずれもx64ビルドのため、それらをネイティブ依存として抱える統合後のアプリでは
      launcher側で使っていた x86/ARM64 は対象から外す。
    -->
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- .NET 9以降はapphostにCET(シャドウスタック)互換フラグが既定で付く。Dolphin(JIT64)/Citra(dynarmic)等の
         JIT系libretroコアはret/callの戻り先を独自に扱うため、有効だと0xC0000409で即死する。無効にする。 -->
    <CETCompat>false</CETCompat>
    <SelfContained>false</SelfContained>

    <UseWinUI>true</UseWinUI>

    <!-- Unpackaged app: MSIX化せず、単純なexeとしてビルド・配布・実行する -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>false</EnableMsixTooling>

    <!-- App.xaml.cs 側で独自の Main() を定義するため、自動生成Mainを無効化 -->
    <DefineConstants>DISABLE_XAML_GENERATED_MAIN</DefineConstants>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!--
    Microsoft.Windows.SDK.BuildTools はここでは明示指定しない。
    Microsoft.WindowsAppSDK が依存関係として必要なバージョンを自動的に解決するため、
    ここでバージョンを固定すると NU1605(パッケージダウングレード検出)でビルドエラーになることがある。
  -->
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Primitives" Version="8.2.251219" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260416003" />
    <PackageReference Include="System.Management" Version="9.0.0" />
  </ItemGroup>

  <!--
    以前ここにあった CHDSharp(DiscSerialReader用)・System.Drawing.Common(BoxArtPlaceholderGenerator用)・
    MessagePack(RetroArchRdbReader用)は、いずれの利用元もEmulatorLauncher.RomLibraryへ
    切り出したのに伴い、パッケージ参照ごとそちらへ移動した(このプロジェクトからは削除)。
  -->

  <!--
    Models/Servicesのうち、WinUIに依存しない共通モデル・純粋ユーティリティを
    EmulatorLauncher.Coreへ切り出した(RomFolderScanService等のライブラリ化の第一段階)。
    RewindFrameInfo/SaveSlotInfoはMicrosoft.UI.Xaml.Media.ImageSourceを保持するため
    このプロジェクト側に残している。
  -->
  <ItemGroup>
    <ProjectReference Include="..\EmulatorLauncher.Core\EmulatorLauncher.Core.csproj" />
    <ProjectReference Include="..\EmulatorLauncher.Net\EmulatorLauncher.Net.csproj" />
    <ProjectReference Include="..\EmulatorLauncher.RomLibrary\EmulatorLauncher.RomLibrary.csproj" />
    <ProjectReference Include="..\EmulatorLauncher.Input\EmulatorLauncher.Input.csproj" />
    <ProjectReference Include="..\EmulatorLauncher.Emulation\EmulatorLauncher.Emulation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!-- launcher側UI(コンソール選択/ゲーム選択)が参照するアイコン・ロゴ類 -->
  <ItemGroup>
    <None Remove="Assets\base_white.png" />
    <None Remove="Assets\system\close.png" />
    <None Remove="Assets\system\gamecontrol.png" />
    <None Remove="Assets\system\setting.png" />
    <None Remove="Assets\Emulator\Background.png" />
    <None Remove="Controls\CollectionEditOverlay.xaml" />
    <None Remove="Controls\ConsoleEditOverlay.xaml" />
    <None Remove="Controls\GameDetailOverlay.xaml" />
    <None Remove="Controls\SortOverlay.xaml" />
    <None Remove="Controls\GamepadMessageOverlay.xaml" />
    <None Remove="Controls\GamepadListPickerOverlay.xaml" />
    <None Remove="Views\CollectionGameSelectPage.xaml" />
    <None Remove="Views\GameSelectPage.xaml" />
    <None Remove="Views\LauncherEditOverlay.xaml" />
  </ItemGroup>

  <!--
    SDL3.dll をプロジェクト直下に置くと、ビルド時に出力フォルダへ自動コピーされます。
    (https://github.com/libsdl-org/SDL/releases から SDL3-devel-x.xx.x-VC.zip 等を入手し、
     lib\x64\SDL3.dll をこのプロジェクトフォルダ直下にコピーしてください)
  -->
  <ItemGroup>
    <None Include="SDL3.dll" Condition="Exists('SDL3.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    ConsoleInfo(コンソール一覧)/LauncherInfo(libretroコア一覧)の設定データ。
    以前は両方とも1つのGameLauncher.json(トップレベルにconsoles/launchers2配列)に
    入っていたが、管理しやすいようConsoles.json/Launchers.jsonへ分離した。
    SampleData.GetConsoles() / GetLaunchers() が実行時にこれらのファイルを読み込む
    (Models/SampleData.cs の LoadConsoles/LoadLaunchers 参照)。
  -->
  <ItemGroup>
    <None Include="Consoles.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="Launchers.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="controllerProfiles.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- システム画面のプラグインのサンプルと説明書(出力フォルダのPlugins\へコピーされる。Pluginsフォルダ自体はユーザーのjsonを置く場所)。 -->
  <ItemGroup>
    <None Include="Plugins\samples\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\PLUGINS.md">
      <Link>Plugins\PLUGINS.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- ウィンドウ/タスクバー用アイコン(MainWindowが実行時にAppWindow.SetIconで読む)。 -->
  <ItemGroup>
    <None Include="Assets\AppIcon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- 効果音(SoundEffectsがAssets/Sound/<名前>.mp3を読み込む。例: move.mp3=カーソル移動)と、BGM(BgmPlayerがAssets/Sound/BGM/*.mp3をランダム再生)。 -->
  <ItemGroup>
    <None Include="Assets\Sound\**\*.mp3">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- 同梱フォント(FontLoaderが起動時にOSへ登録する)。 -->
  <ItemGroup>
    <None Include="Assets\Fonts\*.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    配布物へ同梱するライセンス文書(出力フォルダのlicenses\へコピーされる)。
    LGPL-2.1(CHDSharp内蔵のFLAC部分)・Apache-2.0(Dapper等)は全文の同梱が条件のため、
    必ず配布物へ含めること。LICENSE / THIRD_PARTY_NOTICES.txt はリポジトリ直下のものをリンクで取り込む。
  -->
  <ItemGroup>
    <None Include="licenses\*.txt">
      <Link>licenses\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\LICENSE">
      <Link>licenses\LICENSE.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\THIRD_PARTY_NOTICES.txt">
      <Link>licenses\THIRD_PARTY_NOTICES.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    コンソールごとのRetroArch RDB(libretro-database)定義一覧。
    RdbCatalogServiceが実行時にこのファイルを読み込み、data/rdb/配下に無ければ
    Urlからrdbファイル自体をダウンロードする(Services/RdbCatalogService.cs参照)。
  -->
  <ItemGroup>
    <None Include="data\rdb\rdblist.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>data\rdb\rdblist.json</Link>
    </None>
  </ItemGroup>

  <!--
    アーケード(FBNeo / MAME 2003-Plus)のクローン表(data/arcade/{コンソールId}.json)。ArcadeCloneDbが実行時に読み込む。
    各コアのXMLから「クローン→親」と「隠すセット(BIOS等)」だけを抜き出したもの。
  -->
  <ItemGroup>
    <None Include="data\arcade\*.json" Condition="Exists('data\arcade')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    日本語メタデータ表(data/jdb/{コンソールId}.csv)。JapaneseGameDbが実行時に読み込む。
    ファイルが無くても動くので、あるときだけ出力へコピーする。
  -->
  <ItemGroup>
    <None Include="data\jdb\*.csv" Condition="Exists('data\jdb')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>data\jdb\%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

  <!--
    インストール可能なlibretroコアのカタログ。LibretroCoreCatalogServiceが実行時にここを
    読み書きする(コア管理パネルのインストール/アンインストール状態もここに保存される)。
    以前はCopyToOutputDirectory設定が無く出力先にコピーされていなかったため、常にコピーされる
    よう追加した。
  -->
  <ItemGroup>
    <None Include="cores\libretro.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    動作確認用に libretro コア(.dll)を cores フォルダに置いた場合、自動で出力先にコピーします。
    (任意。無くてもビルドは通ります。ConsoleInfo.CorePath はこの cores フォルダを基準に解決されます)
  -->
  <ItemGroup>
    <None Include="cores\**\*.dll" Condition="Exists('cores')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>cores\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

  <!--
    動作確認用のROMを roms フォルダに置いた場合、自動で出力先にコピーします。
    (任意。GameInfo.RomPath はこの roms フォルダを基準に解決されます)
  -->
  <ItemGroup>
    <None Include="roms\**\*.*" Condition="Exists('roms')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>roms\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>
