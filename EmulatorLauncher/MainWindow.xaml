<Window
    x:Class="EmulatorLauncher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        以前はここに「1920x1080固定キャンバス + Viewbox」を置き、Frame全体を
        一様スケーリングしていたが、GamePlayPage がSDL描画用のネイティブ子/所有
        ウィンドウを画面座標で正確に追従させる必要があるため、Viewboxによる
        スケール変換をこの階層に挟まない方針に変更した(スケール変換があっても
        TransformToVisualは理論上正しく計算できるはずだが、ネイティブHWNDの
        位置あわせは実座標のままの方が単純かつ確実なため)。

        1920x1080前提でデザインされているConsoleSelectPage/GameSelectPageは、
        代わりに各ページ自身の内部でViewboxによるスケーリングを行っている。
        GamePlayPageは元々可変レイアウト(*/Autoの行定義)なので、このFrameの
        実サイズにそのまま追従する。
    -->
    <Grid x:Name="RootBackdrop">
        <Grid.Background>
            <ImageBrush ImageSource="ms-appx:///Assets/base_white.png" Stretch="UniformToFill" />
        </Grid.Background>

        <Frame x:Name="RootFrame" FontFamily="{StaticResource ContentControlThemeFontFamily}" />
    </Grid>
</Window>