<UserControl
    x:Class="EmulatorLauncher.Controls.SystemItemsOrderOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:EmulatorLauncher.Converters"
    xmlns:controls="using:EmulatorLauncher.Controls">

    <!--
        「システム項目の並び替え」の全画面。左に項目の一覧、右に「システム画面の並びのプレビュー」(値は入っていない)。
        並びを動かすと、プレビューの各ブロックがアニメーションで移動する。空白(何も表示しない1マス)を足したり消したりもできる。

        操作:
          - 十字キー上下: 項目を選ぶ。A: つかむ → 上下で動かす → もう一度Aで置く。B: つかんでいる間は元の位置へ戻す/つかんでいなければ保存せず戻る。
          - X: 選んだ項目の下に「空白」を追加。Y: 選んだ「空白」を削除(空白だけ消せる)。
          - 十字キー右: 右のボタン(空白を追加 / 空白を削除 / 保存する)へ。左で一覧へ戻る。保存するまで反映されない。

        使い方(呼び出し側):
            IReadOnlyList<string>? order = await SystemOrderScreen.ShowAsync("システム項目の並び替え", entries);
        保存したときだけ、新しい項目Id順(空白は spacer:xxxx)が返る。変更なし/Bで戻った場合はnull。
        表示中のゲームパッド入力は、呼び出し側の入力処理の先頭で HandleGamepadInput へ渡す。
    -->
    <UserControl.Resources>
        <conv:BoolToBrushConverter x:Key="BoolToBrush" />
        <conv:BoolToMenuHighlightConverter x:Key="RowWhiteHighlight" />
        <conv:BoolToSwitchBlueTextConverter x:Key="SwitchBlueText" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Viewbox Stretch="Uniform">
            <Grid Width="{StaticResource CanvasWidth}" Height="{StaticResource CanvasHeight}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="150" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="160,0,160,0">
                    <TextBlock x:Name="TitleText" FontSize="40" FontWeight="SemiBold"
                               Foreground="{StaticResource AppTextPrimaryBrush}"
                               VerticalAlignment="Bottom" Margin="0,0,0,20" />
                    <Rectangle Height="2" VerticalAlignment="Bottom" Fill="{StaticResource AppTextPrimaryBrush}" Opacity="0.75" />
                </Grid>

                <Grid Grid.Row="1" Margin="160,24,160,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="540" />
                    </Grid.ColumnDefinitions>

                    <ScrollViewer x:Name="ListScrollViewer" Grid.Column="0"
                                  VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto">
                        <Grid>
                        <ItemsControl x:Name="ItemsHost" ItemsSource="{x:Bind Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="controls:SystemOrderEntry">
                                    <Grid Height="84" Tapped="ItemRow_Tapped">
                                        <Border Margin="0,0,0,1" CornerRadius="0" BorderThickness="4"
                                                Background="{x:Bind IsFocused, Mode=OneWay, Converter={StaticResource RowWhiteHighlight}}"
                                                BorderBrush="Transparent" />
                                        <!-- つかんでいる行の目印(薄い青の塗り) -->
                                        <Rectangle Margin="4,4,4,5" Fill="{StaticResource SwitchSelectedBlueBrush}" Opacity="0.18"
                                                   Visibility="{x:Bind IsGrabbed, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="{x:Bind Label}" FontSize="30" VerticalAlignment="Center"
                                                   Margin="28,0,230,1" TextTrimming="CharacterEllipsis"
                                                   Foreground="{x:Bind IsFocused, Mode=OneWay, Converter={StaticResource SwitchBlueText}}" />
                                        <TextBlock Text="{x:Bind KindText}" FontSize="22" FontFamily="Segoe UI Variable, Yu Gothic UI, Segoe UI" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Margin="0,0,80,1" Opacity="0.6" Foreground="{StaticResource AppTextSecondaryBrush}" />
                                        <FontIcon Glyph="&#xE700;" FontSize="28" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="0,0,34,1" Opacity="0.55"
                                                  Foreground="{StaticResource AppTextSecondaryBrush}"
                                                  Visibility="{x:Bind IsGrabbed, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                        <Rectangle Height="1" VerticalAlignment="Bottom" Fill="#FFC8C8C8" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- 一覧のフォーカス枠。選択が変わると、この枠がスライドして移動する。 -->
                        <Border x:Name="ListFocusFrame" Height="83" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                                BorderThickness="4" IsHitTestVisible="False" Opacity="0" />
                        </Grid>
                    </ScrollViewer>

                    <!-- 右: プレビュー(システム画面の並び。値は入っていない) + ボタン -->
                    <Grid Grid.Column="1" Margin="40,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" FontSize="24" FontFamily="Segoe UI Variable, Yu Gothic UI, Segoe UI" Margin="4,4,4,12" TextWrapping="Wrap"
                                   Foreground="{StaticResource AppTextSecondaryBrush}"
                                   Text="システム画面での並びのプレビューです(値は入っていません)。" />

                        <Border x:Name="PreviewFrame" Grid.Row="1" CornerRadius="6" Padding="16">
                            <ScrollViewer x:Name="PreviewScroll" VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Hidden">
                                <Canvas x:Name="PreviewCanvas" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14">
                                    <Border x:Name="PreviewFocusFrame" BorderThickness="3" CornerRadius="8" IsHitTestVisible="False"
                                            Canvas.ZIndex="5" Opacity="0" />
                                </Canvas>
                            </ScrollViewer>
                        </Border>

                        <Grid Grid.Row="2" Margin="0,16,0,0">
                        <StackPanel Spacing="12">
                            <Border Height="72" BorderThickness="4" Tapped="AddButton_Tapped"
                                    Background="{x:Bind AddState.Background, Mode=OneWay}"
                                    BorderBrush="Transparent">
                                <TextBlock Text="空白を追加" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{x:Bind AddState.Foreground, Mode=OneWay}" />
                            </Border>
                            <Border Height="72" BorderThickness="4" Tapped="DeleteButton_Tapped"
                                    Background="{x:Bind DeleteState.Background, Mode=OneWay}"
                                    BorderBrush="Transparent">
                                <TextBlock Text="空白を削除" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{x:Bind DeleteState.Foreground, Mode=OneWay}" />
                            </Border>
                            <Border Height="88" BorderThickness="4" Tapped="SaveButton_Tapped"
                                    Background="{x:Bind SaveState.Background, Mode=OneWay}"
                                    BorderBrush="Transparent">
                                <TextBlock Text="保存する" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{x:Bind SaveState.Foreground, Mode=OneWay}" />
                            </Border>
                        </StackPanel>
                        <Border x:Name="ButtonFocusFrame" Height="72" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                                BorderThickness="4" IsHitTestVisible="False" Opacity="0" />
                        </Grid>
                    </Grid>
                </Grid>

                <controls:HintBar x:Name="NormalHints" Grid.Row="2" Margin="48,0,48,28" HorizontalAlignment="Stretch" ShowFooterFrame="True">
                    <controls:HintBar.Hints>
                        <controls:HintDefinition Key="B" Label="もどる" />
                        <controls:HintDefinition Key="A" Label="つかむ" />
                        <controls:HintDefinition Key="X" Label="空白を追加" />
                        <controls:HintDefinition Key="Y" Label="空白を削除" />
                    </controls:HintBar.Hints>
                </controls:HintBar>
                <controls:HintBar x:Name="GrabHints" Grid.Row="2" Margin="48,0,48,28" HorizontalAlignment="Stretch" ShowFooterFrame="True"
                                  Visibility="Collapsed">
                    <controls:HintBar.Hints>
                        <controls:HintDefinition Key="B" Label="キャンセル" />
                        <controls:HintDefinition Key="DPad" Label="移動" />
                        <controls:HintDefinition Key="A" Label="置く" />
                    </controls:HintBar.Hints>
                </controls:HintBar>
                <controls:HintBar x:Name="ButtonHints" Grid.Row="2" Margin="48,0,48,28" HorizontalAlignment="Stretch" ShowFooterFrame="True"
                                  Visibility="Collapsed">
                    <controls:HintBar.Hints>
                        <controls:HintDefinition Key="B" Label="もどる" />
                        <controls:HintDefinition Key="A" Label="決定" />
                    </controls:HintBar.Hints>
                </controls:HintBar>
            </Grid>
        </Viewbox>
        <controls:ConfirmDialogOverlay x:Name="ConfirmOverlay" Visibility="Collapsed" />
    </Grid>
</UserControl>
