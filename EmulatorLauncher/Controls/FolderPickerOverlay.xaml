<UserControl
    x:Class="EmulatorLauncher.Controls.FolderPickerOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fs="using:EmulatorLauncher.Controls"
    xmlns:conv="using:EmulatorLauncher.Converters"
    xmlns:controls="using:EmulatorLauncher.Controls">

    <!--
        ゲームパッドだけで操作できるフォルダ選択オーバーレイ(OSのFolderPickerの代替)。

        使い方(呼び出し側、例: SettingsPage):
            <controls:FolderPickerOverlay x:Name="FolderPicker" Visibility="Collapsed" />
        コードビハインドから
            string? path = await FolderPicker.ShowAsync("ゲームフォルダを選択", initialPath);
        表示中のゲームパッド入力は、呼び出し側のOnGamepadButtonの先頭で
            if (FolderPicker.IsOpen) { FolderPicker.HandleGamepadInput(button); return; }
        のように渡す。

        ファイル選択はShowFileAsync(title, new[]{".exe",".bat"}, initialPath)。ファイルはAで決定(Xは無効)。
        操作: 十字キー上下で移動 / Aでフォルダへ入る(「このフォルダを選択」行ならそこで決定) /
        Xで今開いているフォルダに決定 / Bで一つ上の階層へ(最上位の一覧ではキャンセル) / Yでいつでもキャンセル。
        マウスなら行のクリックも使える。
    -->
    <UserControl.Resources>
        <conv:BoolToBrushConverter x:Key="BoolToBrush" />
    </UserControl.Resources>

    <Grid Background="{StaticResource OverlayScrimBrush}">
        <Viewbox Stretch="Uniform">
            <Grid Width="{StaticResource CanvasWidth}" Height="{StaticResource CanvasHeight}">
                <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                        Width="1520" Height="920" Background="{StaticResource AppSurfaceBrush}"
                        CornerRadius="{StaticResource PanelCornerRadius}" Padding="48">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="TitleText" Grid.Row="0" Text="フォルダを選択" FontSize="38" FontWeight="SemiBold"
                                   Foreground="{StaticResource AppTextPrimaryBrush}" Margin="0,0,0,12" />

                        <Border Grid.Row="1" Background="{StaticResource PanelBackgroundBrush}"
                                CornerRadius="{StaticResource CardCornerRadius}" Padding="20,12" Margin="0,0,0,16">
                            <TextBlock x:Name="PathText" FontSize="24" Text="" TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource AppTextPrimaryBrush}" />
                        </Border>

                        <ScrollViewer x:Name="ListScrollViewer" Grid.Row="2"
                                      VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Hidden">
                            <ItemsControl x:Name="ItemsHost" ItemsSource="{x:Bind Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="controls:GamepadPickerItem">
                                        <Button Tag="{x:Bind}" Click="ItemButton_Click" AllowFocusOnInteraction="False"
                                                UseSystemFocusVisuals="False"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                Margin="0,4" Padding="24,14" CornerRadius="{StaticResource CardCornerRadius}"
                                                Background="{StaticResource PanelBackgroundBrush}"
                                                BorderThickness="3"
                                                BorderBrush="{x:Bind IsFocused, Converter={StaticResource BoolToBrush}, Mode=OneWay}">
                                            <TextBlock Text="{x:Bind Label}" FontSize="26" TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource AppTextPrimaryBrush}" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock x:Name="EmptyText" Grid.Row="2" Text="サブフォルダはありません" FontSize="24" Opacity="0.6"
                                   Foreground="{StaticResource AppTextPrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />

                        <controls:HintBar x:Name="FolderHints" Grid.Row="3" HorizontalAlignment="Right" Margin="0,20,0,0">
                            <controls:HintBar.Hints>
                                <controls:HintDefinition Key="DPad" Label="選択" />
                                <controls:HintDefinition Key="A" Label="開く/決定" />
                                <controls:HintDefinition Key="X" Label="このフォルダに決定" />
                                <controls:HintDefinition Key="B" Label="上の階層" />
                                <controls:HintDefinition Key="Y" Label="キャンセル" />
                            </controls:HintBar.Hints>
                        </controls:HintBar>
                        <controls:HintBar x:Name="FileHints" Grid.Row="3" HorizontalAlignment="Right" Margin="0,20,0,0"
                                          Visibility="Collapsed">
                            <controls:HintBar.Hints>
                                <controls:HintDefinition Key="DPad" Label="選択" />
                                <controls:HintDefinition Key="A" Label="開く/決定" />
                                <controls:HintDefinition Key="B" Label="上の階層" />
                                <controls:HintDefinition Key="Y" Label="キャンセル" />
                            </controls:HintBar.Hints>
                        </controls:HintBar>
                    </Grid>
                </Border>
            </Grid>
        </Viewbox>
    </Grid>
</UserControl>
