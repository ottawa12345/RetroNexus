<UserControl
    x:Class="EmulatorLauncher.Controls.CycleSelector"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:EmulatorLauncher.Converters">

    <!--
        CycleSelector: 左右の矢印ボタンで選択肢を1つずつ送る値ピッカー。

        WinUIのComboBoxはドロップダウンを開く/選ぶ操作をゲームパッドのD-padに
        直接割り当てる手段が無く、ゲームパッドだけでの操作ができない
        (前回のコントローラー設定画面でぶつかった問題そのもの)。
        このCycleSelectorはマウスなら左右の矢印ボタンをクリックするだけで選べるうえ、
        ページ側のゲームパッド処理からもMoveNext/MovePreviousを直接呼べるので、
        同じ見た目・同じ選択状態のままゲームパッド操作にも対応できる。

        使い方:
            <controls:CycleSelector x:Name="MySelector" SelectionChanged="MySelector_SelectionChanged" />
        そしてコードビハインドから
            MySelector.Choices = choices; // List<CycleChoice>
            MySelector.SelectedValue = "foo";
        のように設定する(SectionHeaderと同じく、DependencyPropertyは使わずプレーンな
        プロパティで実装している)。IsGamepadFocusedをtrueにすると、値の周りに
        アクセントカラーの枠が付く(ページ側が「今ゲームパッドでここを操作している」
        ことを示すために使う)。
    -->
    <UserControl.Resources>
        <conv:BoolToBrushConverter x:Key="BoolToBrush" />
    </UserControl.Resources>

    <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Button Grid.Column="0" Content="◀" Click="PreviousButton_Click"
                Style="{StaticResource RetroButtonStyle}" FontSize="22" Padding="18,10" MinWidth="0" />

        <Border Grid.Column="1" Background="{StaticResource AppSurfaceBrush}" CornerRadius="{StaticResource ChipCornerRadius}"
                BorderBrush="{x:Bind IsGamepadFocused, Mode=OneWay, Converter={StaticResource BoolToBrush}}"
                BorderThickness="3" Padding="16,8" MinWidth="200">
            <TextBlock x:Name="ValueText" Style="{StaticResource CardTitleTextStyle}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
        </Border>

        <Button Grid.Column="2" Content="▶" Click="NextButton_Click"
                Style="{StaticResource RetroButtonStyle}" FontSize="22" Padding="18,10" MinWidth="0" />
    </Grid>
</UserControl>
