<UserControl
    x:Class="EmulatorLauncher.Controls.HintBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EmulatorLauncher.Controls">

    <!--
        画面の操作ガイド(「B もどる」「A 決定」等)の共通UserControl。
        Nintendo Switchのホーム画面・設定画面・ゲーム選択画面のような、カプセル(ピル)を
        使わないフラットな表示にしてある。使う側はHints(HintDefinitionの一覧)を宣言するだけ。

            <controls:HintBar HorizontalAlignment="Right">
                <controls:HintBar.Hints>
                    <controls:HintDefinition Key="B" Label="もどる" />
                    <controls:HintDefinition Key="A" Label="決定" />
                </controls:HintBar.Hints>
            </controls:HintBar>

        表示形式は3種類(いずれもプロパティで切り替える):
          - 既定(フラット): 明るい背景の上にそのまま置く。「濃色の丸+白抜き文字+濃色ラベル」。
                (トップ画面/設定画面の右下、白いパネルの中のガイドなど)
          - ShowFooterFrame="True": 上記に加えて、上端に区切り線、左端にコントローラー
                アイコンを付ける(Switchのホーム/設定画面の最下段と同じ)。横幅いっぱいに
                置くこと(HorizontalAlignment="Stretch")。
          - IsOverlay="True": 暗い半透明の帯(左上だけ丸角)にして「白の丸+濃色文字+白ラベル」へ
                反転する。ゲーム選択のカバー一覧・詳細/ソート・中断メニュー・巻き戻しなど、
                画面の右下隅へぴったり寄せて重ねる用途(HorizontalAlignment="Right"
                VerticalAlignment="Bottom" Margin="0")。

        Key="DPad" を指定すると、丸バッジの代わりに十字キーのアイコンを表示する。
        Key が2文字以上("ZL+ZR"等)の場合は、丸バッジが横に伸びる。
        ラベルを実行中に変えたい場合は、HintDefinitionへx:Nameを付けてLabelを書き換える
        (HintDefinitionはINotifyPropertyChangedに対応している)。
    -->
    <Grid>
        <Border x:Name="BarBorder" Padding="0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ItemsControl x:Name="HintItemsControl" Grid.Column="1" ItemsSource="{x:Bind Hints}"
                              HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="44" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="controls:HintDefinition">
                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Background="Transparent">
                                <!-- 十字キーアイコン(Key="DPad"の時だけ表示) -->
                                <Viewbox Width="{ThemeResource HintBadgeSize}" Height="{ThemeResource HintBadgeSize}"
                                         Visibility="{x:Bind DPadVisibility}">
                                    <Canvas Width="200" Height="200">
                                        <Path Fill="{ThemeResource HintBadgeFillBrush}" StrokeLineJoin="Round"
                                              Stroke="{ThemeResource HintBadgeFillBrush}" StrokeThickness="6"
                                              Data="M 80,20 H 120 a 6,6 0 0 1 6,6 V 74 H 174 a 6,6 0 0 1 6,6 V 120 a 6,6 0 0 1 -6,6 H 126 V 174 a 6,6 0 0 1 -6,6 H 80 a 6,6 0 0 1 -6,-6 V 126 H 26 a 6,6 0 0 1 -6,-6 V 80 a 6,6 0 0 1 6,-6 H 74 V 26 a 6,6 0 0 1 6,-6 Z" />
                                    </Canvas>
                                </Viewbox>

                                <!-- 丸バッジ(A/B/X/Y等。Key="DPad"以外の時に表示。塗りつぶしの丸+白抜き文字) -->
                                <Border MinWidth="{ThemeResource HintBadgeSize}" Height="{ThemeResource HintBadgeSize}"
                                        CornerRadius="22" Padding="10,0"
                                        Background="{ThemeResource HintBadgeFillBrush}"
                                        Visibility="{x:Bind BadgeVisibility}">
                                    <Grid>
                                        <TextBlock Text="{x:Bind BadgeKey, Mode=OneWay}"
                                                   Visibility="{x:Bind NormalGlyphVisibility, Mode=OneWay}"
                                                   FontSize="{ThemeResource HintBadgeGlyphFontSize}" FontWeight="Bold"
                                                   Foreground="{ThemeResource HintBadgeGlyphBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Margin="0,0,0,2" />
                                        <!-- 1PがPS系のとき: ○ ✕ △ □(色付き)。 -->
                                        <!-- フォントの記号は線の太さを変えられないので、図形で描く(線の太さ3.2)。
                                             △は見た目の重心が下に寄らないよう、少し上に置いている。 -->
                                        <Viewbox Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                 Visibility="{x:Bind PsGlyphVisibility, Mode=OneWay}">
                                            <Canvas Width="24" Height="24">
                                                <Ellipse Canvas.Left="3" Canvas.Top="3" Width="18" Height="18"
                                                         Stroke="{x:Bind PsBrush, Mode=OneWay}" StrokeThickness="3.2"
                                                         Visibility="{x:Bind PsCircleVisibility, Mode=OneWay}" />
                                                <Path Data="M 4,4 L 20,20 M 20,4 L 4,20"
                                                      Stroke="{x:Bind PsBrush, Mode=OneWay}" StrokeThickness="3.2"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Visibility="{x:Bind PsCrossVisibility, Mode=OneWay}" />
                                                <Rectangle Canvas.Left="3.5" Canvas.Top="3.5" Width="17" Height="17"
                                                           Stroke="{x:Bind PsBrush, Mode=OneWay}" StrokeThickness="3.2"
                                                           Visibility="{x:Bind PsSquareVisibility, Mode=OneWay}" />
                                                <Path Data="M 12,2.5 L 21.5,18.5 L 2.5,18.5 Z"
                                                      Stroke="{x:Bind PsBrush, Mode=OneWay}" StrokeThickness="3.2"
                                                      StrokeLineJoin="Round"
                                                      Visibility="{x:Bind PsTriangleVisibility, Mode=OneWay}" />
                                            </Canvas>
                                        </Viewbox>
                                    </Grid>
                                </Border>

                                <TextBlock Text="{x:Bind Label, Mode=OneWay}"
                                           FontSize="{ThemeResource HintLabelFontSize}" FontWeight="SemiBold"
                                           Foreground="{ThemeResource HintForegroundBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- 上端の区切り線(ShowFooterFrame時のみ) -->
        <Border x:Name="FooterLine" Height="2" VerticalAlignment="Top"
                Background="{ThemeResource HintFooterLineBrush}" Visibility="Collapsed" />
    </Grid>
</UserControl>
