<UserControl
    x:Class="EmulatorLauncher.Controls.MultiChoiceOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fs="using:EmulatorLauncher.Controls"
    xmlns:conv="using:EmulatorLauncher.Converters"
    xmlns:controls="using:EmulatorLauncher.Controls">

    <!--
        複数の項目から、いくつでも選ぶ全画面(特殊割り当ての「HotkeyEditOverlay」と同じ構成)。
        左: 項目の一覧。Aで「選択/解除」を切り替える(チェックが付く)。
        右: 説明と、いま選んでいる項目、「適用」ボタン。
        十字キー上下: 移動 / 右: 「適用」へ / 左・上: 一覧へ戻る / X: 全部解除 / B: 変更せず閉じる

            <controls:MultiChoiceOverlay x:Name="Picker" Visibility="Collapsed" />
            string[]? ids = await Picker.ShowAsync(title, rows, help, summaryHeader);   // nullなら取り消し
            表示中のゲームパッド入力は HandleGamepadInput へ渡す。
    -->
    <UserControl.Resources>
        <conv:BoolToBrushConverter x:Key="BoolToBrush" />
        <conv:BoolToMenuHighlightConverter x:Key="RowWhiteHighlight" />
        <conv:BoolToSwitchBlueTextConverter x:Key="SwitchBlueText" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Viewbox Stretch="Uniform">
            <Grid Width="{StaticResource CanvasWidth}" Height="{StaticResource CanvasHeight}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="150" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="160,0,160,0">
                    <TextBlock x:Name="TitleText" Text="" FontSize="40" FontWeight="SemiBold"
                               Foreground="{StaticResource AppTextPrimaryBrush}"
                               VerticalAlignment="Bottom" Margin="0,0,0,20" />
                    <Rectangle Height="2" VerticalAlignment="Bottom" Fill="{StaticResource AppTextPrimaryBrush}" Opacity="0.75" />
                </Grid>

                <Grid Grid.Row="1" Margin="160,24,160,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="520" />
                    </Grid.ColumnDefinitions>

                    <!-- 左: ボタンの一覧(選ぶとチェックが付く) -->
                    <ScrollViewer x:Name="RowsScrollViewer" Grid.Column="0"
                                  VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="ItemsHost" ItemsSource="{x:Bind Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="controls:MultiChoiceRow">
                                    <Grid MinHeight="92" Tapped="Row_Tapped">
                                        <Border Margin="0,0,0,1" CornerRadius="0" BorderThickness="4"
                                                Background="{x:Bind IsFocused, Mode=OneWay, Converter={StaticResource RowWhiteHighlight}}"
                                                BorderBrush="{x:Bind IsFocused, Mode=OneWay, Converter={StaticResource BoolToBrush}}" fs:FocusSlide.IsFocused="{x:Bind IsFocused, Mode=OneWay}" />
                                        <TextBlock Text="{x:Bind Label}" FontSize="30" VerticalAlignment="Center"
                                                   Margin="28,0,100,1" TextWrapping="Wrap"
                                                   Foreground="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource SwitchBlueText}}" />
                                        <Grid Width="48" Height="48" HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Margin="0,0,28,1"
                                              Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                            <Ellipse Fill="{StaticResource SwitchSelectedBlueBrush}" />
                                            <FontIcon Glyph="&#xE73E;" FontSize="26" Foreground="White"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                        <Rectangle Height="1" VerticalAlignment="Bottom" Fill="#FFC8C8C8" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 右: 説明 + 現在の組み合わせ + 適用ボタン -->
                    <Grid Grid.Column="1" Margin="48,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="4,16,4,0" Spacing="28">
                            <TextBlock x:Name="HelpText" FontSize="24" TextWrapping="Wrap"
                                       Foreground="{StaticResource AppTextSecondaryBrush}" />
                            <StackPanel Spacing="6">
                                <TextBlock x:Name="SummaryHeaderText" Text="選んだ項目" FontSize="22"
                                           Foreground="{StaticResource AppTextSecondaryBrush}" />
                                <TextBlock x:Name="SummaryText" FontSize="32" FontWeight="SemiBold" TextWrapping="Wrap"
                                           Foreground="{StaticResource SwitchSelectedBlueBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Row="1" Height="96" CornerRadius="0" BorderThickness="4" Background="{StaticResource AppSurfaceBrush}"
                                Tapped="ApplyButton_Tapped"
                                BorderBrush="{x:Bind ApplyState.IsFocused, Mode=OneWay, Converter={StaticResource BoolToBrush}}">
                            <TextBlock Text="適用" FontSize="30" FontWeight="SemiBold"
                                       Foreground="{StaticResource AppTextPrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Grid>

                <controls:HintBar Grid.Row="2" Margin="48,0,48,28" HorizontalAlignment="Stretch" ShowFooterFrame="True">
                    <controls:HintBar.Hints>
                        <controls:HintDefinition Key="B" Label="もどる" />
                        <controls:HintDefinition Key="X" Label="すべて解除" />
                        <controls:HintDefinition Key="A" Label="選択/決定" />
                    </controls:HintBar.Hints>
                </controls:HintBar>
            </Grid>
        </Viewbox>
        <controls:ConfirmDialogOverlay x:Name="ConfirmOverlay" Visibility="Collapsed" />
    </Grid>
</UserControl>
