<UserControl
    x:Class="EmulatorLauncher.Controls.SectionHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        パネル見出し(「タイトル + (N件) + 読み込み中インジケーター + 右端の操作ボタン」)の
        共通UserControl。SettingsPageの3パネル(コア管理/コア毎の設定/ゲームフォルダ管理)で
        ほぼ同じ構造がコピペされていたものを1つにまとめたもの。

        使い方:
            <controls:SectionHeader x:Name="MyHeader" Margin="0,0,0,24" />
        そしてコードビハインドから
            MyHeader.Title = "コア管理";
            MyHeader.CountText = "(12件)";       // 空文字/nullなら非表示
            MyHeader.IsLoading = true;            // ローディングリングの表示切替
            MyHeader.ActionButtonText = "＋ 新規追加"; // 空文字/nullなら操作ボタン自体を非表示
            MyHeader.ActionClick += (_, _) => { ... };
        のようにプロパティを設定する(既存ページのコードビハインドが個々のTextBlock等を
        直接操作していたのと同じ考え方で、DependencyPropertyは使っていない)。
    -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
            <TextBlock x:Name="TitleText" Style="{StaticResource SectionTitleTextStyle}" VerticalAlignment="Center" />
            <TextBlock x:Name="CountTextBlock" Style="{StaticResource CountTextStyle}" VerticalAlignment="Center"
                       Visibility="Collapsed" />
            <ProgressRing x:Name="LoadingRing" Width="28" Height="28" IsActive="False" VerticalAlignment="Center" />
        </StackPanel>

        <Button x:Name="ActionButtonElement" Grid.Column="1" Click="ActionButtonElement_Click"
                Style="{StaticResource RetroButtonStyle}" Visibility="Collapsed" />
    </Grid>
</UserControl>
