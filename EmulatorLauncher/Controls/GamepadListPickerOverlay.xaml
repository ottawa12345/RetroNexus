<UserControl
    x:Class="EmulatorLauncher.Controls.GamepadListPickerOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fs="using:EmulatorLauncher.Controls"
    xmlns:conv="using:EmulatorLauncher.Converters"
    xmlns:controls="using:EmulatorLauncher.Controls">

    <!--
        1個選ぶだけの一覧選択オーバーレイ(ContentDialog+ListViewの代替)。

        WinUIのContentDialogは開閉・既定ボタンの選択にゲームパッドのD-padで触れる手段が無いため、
        CollectionEditOverlow/GameDetailOverlayと同じ「ページ全体を覆うUserControl+
        HandleGamepadInput」方式に置き換えたもの。SettingsPageの「ゲームフォルダ管理」で、
        新規追加したフォルダに対応するコンソールを選ばせる場面(以前はContentDialog+ListView)
        で使う想定だが、項目(GamepadPickerItem.Label/Tag)さえ用意すればどんな一覧選択にも
        使い回せる汎用部品にしてある。

        使い方(呼び出し側、例: SettingsPage):
            <controls:GamepadListPickerOverlay x:Name="ListPickerOverlay" Visibility="Collapsed" />
        そしてコードビハインドから
            GamepadPickerItem? picked = await ListPickerOverlay.ShowAsync(
                "対応するコンソールを選択",
                consoles.Select(c => new GamepadPickerItem { Label = c.Name, Tag = c }));
            if (picked?.Tag is ConsoleInfo selected) { ... }
        表示中のゲームパッド入力は、呼び出し側のOnGamepadButtonの先頭で
            if (ListPickerOverlay.IsOpen) { ListPickerOverlay.HandleGamepadInput(button); return; }
        のように渡す。十字キー上下で移動、Aで決定(ShowAsyncの戻り値にその項目)、
        Bでキャンセル(戻り値null)。マウスなら項目をクリックしてもその場で決定する。
    -->
    <UserControl.Resources>
        <conv:BoolToBrushConverter x:Key="BoolToBrush" />
    </UserControl.Resources>

    <Grid Background="{StaticResource OverlayScrimBrush}">
        <Viewbox Stretch="Uniform">
            <Grid Width="{StaticResource CanvasWidth}" Height="{StaticResource CanvasHeight}">
                <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                        Width="1000" MaxHeight="900" Background="{StaticResource AppSurfaceBrush}"
                        CornerRadius="{StaticResource PanelCornerRadius}" Padding="48">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="TitleText" Grid.Row="0" Text="選択してください" FontSize="38" FontWeight="SemiBold"
                                   Foreground="{StaticResource AppTextPrimaryBrush}" Margin="0,0,0,24" />

                        <ScrollViewer x:Name="ListScrollViewer" Grid.Row="1"
                                      VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto"
                                      MaxHeight="600">
                            <ItemsControl x:Name="ItemsHost" ItemsSource="{x:Bind Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="controls:GamepadPickerItem">
                                        <Button Tag="{x:Bind}" Click="ItemButton_Click" AllowFocusOnInteraction="False"
                                                UseSystemFocusVisuals="False"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                Margin="0,6" Padding="24,18" CornerRadius="{StaticResource CardCornerRadius}"
                                                Background="{StaticResource PanelBackgroundBrush}"
                                                BorderThickness="3"
                                                BorderBrush="{x:Bind IsFocused, Converter={StaticResource BoolToBrush}, Mode=OneWay}" fs:FocusSlide.IsFocused="{x:Bind IsFocused, Mode=OneWay}">
                                            <TextBlock Text="{x:Bind Label}" FontSize="28"
                                                       Foreground="{StaticResource AppTextPrimaryBrush}" TextWrapping="Wrap" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <controls:HintBar Grid.Row="2" HorizontalAlignment="Right" Margin="0,24,0,0">
                            <controls:HintBar.Hints>
                                <controls:HintDefinition Key="DPad" Label="選択" />
                                <controls:HintDefinition Key="A" Label="決定" />
                                <controls:HintDefinition Key="B" Label="キャンセル" />
                            </controls:HintBar.Hints>
                        </controls:HintBar>
                    </Grid>
                </Border>
            </Grid>
        </Viewbox>
    </Grid>
</UserControl>
