<!--
    HintTheme.xaml: HintBar(操作ガイド)専用のテーマ別リソース。

    Nintendo Switchのホーム画面/設定画面のように、明るい背景では
        「濃色の丸 + 白抜きのボタン文字 + 濃色のラベル」
    暗い背景(ゲーム選択のカバー一覧、中断メニュー、巻き戻し等の上に重ねる帯)では
        「白の丸 + 濃色のボタン文字 + 白のラベル」
    と配色が反転する。HintBar自身のRequestedTheme(Light/Dark)を切り替えるだけで
    この配色(と、暗い帯用にやや小さくした寸法)へ切り替わるよう、
    ThemeDictionariesにまとめてある(HintBar.xaml.csのIsOverlay参照)。
    寸法(x:Double)をテーマ辞書に入れているのは、HintBarのItemTemplateが
    HintDefinition以外のプロパティへバインドできないための割り切り。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="HintForegroundBrush" Color="#FF2D2D2D" />
            <SolidColorBrush x:Key="HintBadgeFillBrush" Color="#FF2D2D2D" />
            <SolidColorBrush x:Key="HintBadgeGlyphBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="HintFooterLineBrush" Color="#FFB4B4B4" />
            <x:Double x:Key="HintLabelFontSize">32</x:Double>
            <x:Double x:Key="HintBadgeSize">44</x:Double>
            <x:Double x:Key="HintBadgeGlyphFontSize">27</x:Double>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="HintForegroundBrush" Color="#FF2D2D2D" />
            <SolidColorBrush x:Key="HintBadgeFillBrush" Color="#FF2D2D2D" />
            <SolidColorBrush x:Key="HintBadgeGlyphBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="HintFooterLineBrush" Color="#FFB4B4B4" />
            <x:Double x:Key="HintLabelFontSize">32</x:Double>
            <x:Double x:Key="HintBadgeSize">44</x:Double>
            <x:Double x:Key="HintBadgeGlyphFontSize">27</x:Double>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="HintForegroundBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="HintBadgeFillBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="HintBadgeGlyphBrush" Color="#FF2D2D2D" />
            <SolidColorBrush x:Key="HintFooterLineBrush" Color="#FF808080" />
            <x:Double x:Key="HintLabelFontSize">30</x:Double>
            <x:Double x:Key="HintBadgeSize">42</x:Double>
            <x:Double x:Key="HintBadgeGlyphFontSize">26</x:Double>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
