<!--
    Spacing.xaml: 角丸・余白などレイアウト系の定数をリソース化したもの。
    「カードの角丸は24」のような値を画面ごとに個別に書くのをやめ、役割名で揃える。
    まずは再利用価値の高いCornerRadiusと、代表的な余白だけを定義する
    (全てのMargin/Paddingを網羅的にリソース化すると煩雑になるため、
    頻出パターンだけに絞ってある)。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ 角丸 ============ -->
    <!-- 画面いっぱいの大きなパネル(左メニュー、右コンテンツ領域)。 -->
    <CornerRadius x:Key="PanelCornerRadius">24</CornerRadius>
    <!-- ボタン、ピル型のバッジ。 -->
    <CornerRadius x:Key="ButtonCornerRadius">20</CornerRadius>
    <!-- 一覧の行(カード)。 -->
    <CornerRadius x:Key="CardCornerRadius">16</CornerRadius>
    <!-- 小さめのチップ・入れ子のリスト項目。 -->
    <CornerRadius x:Key="ChipCornerRadius">14</CornerRadius>

    <!-- ============ 余白 ============ -->
    <!-- 画面の外周マージン(ヘッダー・メインコンテンツ・フッター共通)。 -->
    <Thickness x:Key="PageMargin">48,44,48,40</Thickness>
    <!-- パネル(Border)の内側パディング。 -->
    <Thickness x:Key="PanelPadding">40</Thickness>
    <!-- 一覧の行(カード)の内側パディング。 -->
    <Thickness x:Key="CardPadding">28,18</Thickness>

    <!-- 各画面の固定キャンバスの大きさ(仮想解像度)。既定は1920x1080。
         アプリ設定「仮想解像度」の値で、起動時(App.xaml.cs)に上書きされる。 -->
    <x:Double x:Key="CanvasWidth">1920</x:Double>
    <x:Double x:Key="CanvasHeight">1080</x:Double>
</ResourceDictionary>
