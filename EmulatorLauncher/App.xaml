<Application
    x:Class="EmulatorLauncher.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />

                <!-- 配色・フォント・余白の共通定義(Styles/配下)。
                     読み込み順序に注意: Brushes.xamlはColors.xamlの<Color>を、
                     Typography.xamlはBrushes.xamlの<SolidColorBrush>を参照しているため、
                     Colors → Brushes → Typography → Spacing の順で読み込む必要がある
                     (WinUIのMergedDictionariesは後で読み込んだ辞書からでも前の辞書の
                     StaticResourceキーを解決できるが、依存関係の意図を明確にするため
                     この順序を守る)。 -->
                <ResourceDictionary Source="Styles/Colors.xaml" />
                <ResourceDictionary Source="Styles/Brushes.xaml" />
                <ResourceDictionary Source="Styles/Typography.xaml" />
                <ResourceDictionary Source="Styles/Spacing.xaml" />
                <!-- HintBar(操作ガイド)専用のテーマ別リソース(明るい背景=濃色の丸、暗い背景=白の丸)。 -->
                <ResourceDictionary Source="Styles/HintTheme.xaml" />
                <!-- ButtonStyles.xamlはBrushes/Typography/Spacingのキーを参照するため、
                     それらの後に読み込む。 -->
                <ResourceDictionary Source="Styles/ButtonStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- アプリ全体の書体(M PLUS Rounded 1c)。FontLoaderが起動時にOSへ登録する。
                 未登録でも後ろのフォールバック(Segoe UI等)で表示される。 -->
            <FontFamily x:Key="ContentControlThemeFontFamily">Rounded Mplus 1c, Segoe UI Variable, Segoe UI, Yu Gothic UI</FontFamily>
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource ContentControlThemeFontFamily}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
