<Page
    x:Class="EmulatorLauncher.Views.ControllerSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fs="using:EmulatorLauncher.Controls"
    xmlns:conv="using:EmulatorLauncher.Converters"
    xmlns:controls="using:EmulatorLauncher.Controls"
    xmlns:models="using:EmulatorLauncher.Models"
    Background="{StaticResource SettingsPageBackgroundBrush}">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:BoolToBrushConverter x:Key="BoolToBrush" />
        <conv:BoolToMenuHighlightConverter x:Key="RowWhiteHighlight" />
        <conv:BoolToSwitchBlueTextConverter x:Key="SwitchBlueText" />
        <Style x:Key="InfoLabelTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="Foreground" Value="{StaticResource AppTextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,6" />
        </Style>
        <Style x:Key="InfoValueTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="Foreground" Value="{StaticResource AppTextSecondaryBrush}" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="24,6,0,6" />
        </Style>
    </Page.Resources>

    <!--
        コントローラー設定(2026年に作り直し)。設定画面(SettingsPage)と同じ構成で、
        左のメニューが2つ、右がその内容:
          ・基本設定 : 「コントローラーの入れ替え」(1Pと2Pの入れ替え)と、接続中のコントローラー情報。
          ・コントローラ設定 : コンソールを選び、今使っているコントローラー(画像)を基準に、各ボタンへコンソールのボタンを割り当てる。
            ゲーム中の呼び出し操作(中断メニュー/巻き戻し/早送り)の組み合わせも、同じ画面で変える。
            設定はコア毎ではなくコンソール毎に保存する(ControllerMappingService)。
        ゲームパッド操作: 十字キー上下でメニュー、右/Aで右側へ入る、左/Bで左のメニューへ戻る(メニューにいる間のBは前の画面へ)。
        右側(コントローラ設定)では、十字キーでコントローラー図のボタンや右の項目へ移動し、Aで選択画面を開く。
        コントローラー図とその上の項目は、コード側(ControllerSettingsPage.xaml.cs)で組み立てる
        (コンソールごとに形が違うため)。
        1920x1080の固定キャンバスをViewboxで拡縮する(他の画面と同じ)。
    -->
    <Grid>
        <Viewbox Stretch="Uniform">
            <Grid Width="{StaticResource CanvasWidth}" Height="{StaticResource CanvasHeight}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="150" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ヘッダー(設定画面と同じ体裁) -->
                <Grid Grid.Row="0" Margin="48,44,48,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE7FC;" FontSize="56"
                              Foreground="{StaticResource AppTextPrimaryBrush}"
                              VerticalAlignment="Center" Margin="12,0,20,0" />
                    <TextBlock x:Name="HeaderTitle" Grid.Column="1" Text="コントローラ" Style="{StaticResource PageTitleTextStyle}"
                               HorizontalAlignment="Left" VerticalAlignment="Center" />
                    <Border Grid.ColumnSpan="2" Height="2" VerticalAlignment="Bottom"
                            Background="{StaticResource AppTextPrimaryBrush}" Opacity="0.75" Margin="0,0,0,-2" />
                </Grid>

                <Grid Grid.Row="1" Margin="48,8,48,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="MenuColumn" Width="440" />
                        <ColumnDefinition x:Name="GapColumn" Width="32" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 右の内容領域の背景(メニューとの間の隙間も含む)。メニュー側よりわずかに暗い。 -->
                    <Border Grid.Column="1" Grid.ColumnSpan="2" Background="{StaticResource SettingsContentBackgroundBrush}" />

                    <!-- 左: メニュー(基本設定 / コントローラ設定) -->
                    <Border x:Name="CategoryMenuBorder" Grid.Column="0" Background="Transparent" Padding="0,8,16,0">
                        <ItemsControl x:Name="CategoryItemsControl" ItemsSource="{x:Bind Categories}" VerticalAlignment="Top">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:SettingsCategoryItem">
                                    <Grid MinHeight="88" Tapped="CategoryItem_Tapped">
                                        <Border Margin="0,0,0,1" CornerRadius="0" BorderThickness="4" Tag="ShakeTarget"
                                                Background="{x:Bind IsFocused, Mode=OneWay, Converter={StaticResource RowWhiteHighlight}}"
                                                BorderBrush="{x:Bind IsFocused, Mode=OneWay, Converter={StaticResource BoolToBrush}}" fs:FocusSlide.IsFocused="{x:Bind IsFocused, Mode=OneWay}" />
                                        <Rectangle Width="5" Height="58" Margin="14,0,0,1" HorizontalAlignment="Left"
                                                   VerticalAlignment="Center" Fill="{StaticResource SwitchSelectedBlueBrush}"
                                                   Visibility="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="{x:Bind Label}" FontSize="30" FontWeight="Normal"
                                                   Margin="40,0,12,1" VerticalAlignment="Center" TextWrapping="Wrap"
                                                   Foreground="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource SwitchBlueText}}" />
                                        <Rectangle Height="1" VerticalAlignment="Bottom" Fill="#FFC8C8C8" Margin="12,0,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- 左下: 前の画面に戻る(マウス/タッチ用。ゲームパッドは十字キーでここへ移り、Aで戻る。Bでも戻る)。
                         操作中の枠(BackToPreviousFocusFrame)は、左メニューの選択枠と同じように、前の行から滑って来る。
                         枠はボタンの後ろに敷く(塗りが文字を隠さないように)。 -->
                    <Grid x:Name="BackToPreviousHost" Grid.Column="0" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                          Margin="24,0,32,28">
                        <Border x:Name="BackToPreviousFocusFrame" CornerRadius="0" BorderThickness="4"
                                IsHitTestVisible="False" Visibility="Collapsed" />
                        <Border x:Name="BackToPreviousButton" MinHeight="64" Padding="24,0" CornerRadius="0" BorderThickness="2"
                                BorderBrush="LightGray" Background="Transparent" Tapped="BackToPreviousButton_Tapped">
                            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE72B;" FontSize="28" Foreground="{StaticResource AppTextPrimaryBrush}" />
                                <TextBlock Text="前の画面に戻る" FontSize="26" Foreground="{StaticResource AppTextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 右: 基本設定 -->
                    <Border x:Name="BasicPanel" Grid.Column="2" Background="Transparent" Padding="32,8,8,8">
                        <ScrollViewer x:Name="BasicScroll" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Enabled">
                            <StackPanel>
                                <Rectangle Height="1" Fill="#FFCFCFCF" />
                                <!-- 「コントローラーの入れ替え」(項目名の行だけが白背景+水色の枠。説明文は枠の外) -->
                                <Grid Tapped="SwapEntry_Tapped">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border x:Name="SwapEntryBorder" Grid.Row="0" MinHeight="84" Margin="0,12,0,0"
                                            CornerRadius="0" BorderThickness="4" Background="Transparent" BorderBrush="Transparent">
                                        <TextBlock Text="コントローラの入れ替え" FontSize="30" Margin="24,0"
                                                   Foreground="{StaticResource AppTextPrimaryBrush}" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Row="1" Text="1Pと2Pのコントローラを入れ替えます。コントローラが1台だけのときは、その1台が1P⇄2Pに移ります。アプリを再起動すると、接続した順に戻ります。"
                                               FontSize="26" Margin="48,16,48,12"
                                               Foreground="{StaticResource AppTextSecondaryBrush}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="SwapStatusText" Grid.Row="2" FontSize="26" Margin="48,0,48,20"
                                               Foreground="{StaticResource SwitchSelectedBlueBrush}" TextWrapping="Wrap"
                                               Visibility="Collapsed" />
                                    <Rectangle Grid.Row="2" Height="1" VerticalAlignment="Bottom" Fill="#FFCFCFCF" />
                                </Grid>

                                <!-- 「振動の強さ」(0〜100%。左右で変える。変えると短く振動して強さを確かめられる) -->
                                <Grid Tapped="RumbleEntry_Tapped">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border x:Name="RumbleEntryBorder" Grid.Row="0" MinHeight="84" Margin="0,12,0,0"
                                            CornerRadius="0" BorderThickness="4" Background="Transparent" BorderBrush="Transparent">
                                        <Grid Margin="24,0">
                                            <TextBlock Text="振動の強さ" FontSize="30"
                                                       Foreground="{StaticResource AppTextPrimaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock x:Name="RumbleValueText" FontSize="30" HorizontalAlignment="Right"
                                                       Foreground="{StaticResource SwitchSelectedBlueBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Grid.Row="1" Text="ゲーム中のコントローラの振動の強さを変えます。左右で変えられます。変えると短く振動して、強さを確かめられます。0%にすると振動しません。"
                                               FontSize="26" Margin="48,16,48,20"
                                               Foreground="{StaticResource AppTextSecondaryBrush}" TextWrapping="Wrap" />
                                    <Rectangle Grid.Row="1" Height="1" VerticalAlignment="Bottom" Fill="#FFCFCFCF" />
                                </Grid>

                                <!-- 「コントローラー情報」の見出し(ここにフォーカスして上下キーで下の情報をスクロールする) -->
                                <Border x:Name="InfoHeaderBorder" MinHeight="72" Margin="0,20,0,8"
                                        CornerRadius="0" BorderThickness="4" Background="Transparent" BorderBrush="Transparent">
                                    <TextBlock Text="コントローラ情報" FontSize="30" Margin="24,0"
                                               Foreground="{StaticResource AppTextPrimaryBrush}" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel x:Name="ControllerInfoPanel" Margin="28,0,28,24" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- 右: コントローラ設定(中身はコード側で組み立てる) -->
                    <Border x:Name="ConsolePanel" Grid.Column="2" Background="Transparent" Padding="32,8,8,8"
                            Visibility="Collapsed">
                        <Grid x:Name="ConsoleHost" Width="1312" HorizontalAlignment="Left">
                            <!-- 固定部分: コンソール行・コントローラー画像・説明文 -->
                            <Canvas x:Name="ConsoleCanvas" Width="1312" Height="740"
                                    HorizontalAlignment="Left" VerticalAlignment="Top" />
                            <!-- 右の一覧(ボタンの割り当て・特殊割り当て)だけがスクロールする -->
                            <ScrollViewer x:Name="ConsoleScroll" Width="672" Margin="640,100,0,0"
                                          HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                          VerticalScrollBarVisibility="Auto" VerticalScrollMode="Enabled"
                                          HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                                <Canvas x:Name="ListCanvas" Width="672" Height="900"
                                        HorizontalAlignment="Left" VerticalAlignment="Top" />
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <controls:HintBar Grid.Row="2" Margin="48,0,48,28" HorizontalAlignment="Stretch" ShowFooterFrame="True">
                    <controls:HintBar.Hints>
                        <controls:HintDefinition Key="DPad" Label="移動" />
                        <controls:HintDefinition Key="B" Label="もどる" />
                        <controls:HintDefinition Key="A" Label="決定" />
                    </controls:HintBar.Hints>
                </controls:HintBar>

                <!-- 接続中のコントローラー(1P/2P)。入れ替えで、どれが1Pかを見分けるのにも使える。 -->
                <controls:ControllerStatusIndicator Grid.Row="2" Margin="48,0,48,28" VerticalAlignment="Bottom"
                                                    HorizontalAlignment="Left" />
            </Grid>
        </Viewbox>

        <!-- 選択画面(コンソール/ボタン/組み合わせ)と確認ダイアログ -->
        <controls:FullScreenChoiceOverlay x:Name="ChoiceOverlay" Visibility="Collapsed" />
        <controls:ConfirmDialogOverlay x:Name="ConfirmOverlay" Visibility="Collapsed" />
        <controls:HotkeyEditOverlay x:Name="HotkeyEditor" Visibility="Collapsed" />
    </Grid>
</Page>
