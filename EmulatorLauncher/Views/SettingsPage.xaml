                            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="Transparent" />
                            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedUnfocused" Color="Transparent" />
                            <SolidColorBrush x:Key="ListViewItemFocusBorderBrush" Color="Transparent" />
                            <SolidColorBrush x:Key="ListViewItemFocusSecondaryBorderBrush" Color="Transparent" />
                            <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="Transparent" />
                            <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPointerOverBrush" Color="Transparent" />
                            <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPressedBrush" Color="Transparent" />
                            <SolidColorBrush x:Key="ListViewItemSelectionIndicatorDisabledBrush" Color="Transparent" />
                        </ListView.Resources>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                      <Setter Property="FocusVisualPrimaryThickness" Value="0" />
                                      <Setter Property="FocusVisualSecondaryThickness" Value="0" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:LibretroCoreListItem">
                                <Grid MinHeight="104" Tapped="CoreRow_Tapped">
                                    <Border Margin="0,0,0,1" CornerRadius="0" BorderThickness="4"
                                            Background="{x:Bind IsFocused, Mode=OneWay, Converter={StaticResource RowWhiteHighlight}}"
                                            BorderBrush="{x:Bind IsFocused, Mode=OneWay, Converter={StaticResource BoolToBrush}}" fs:FocusSlide.IsFocused="{x:Bind IsFocused, Mode=OneWay}" />
                                    <Grid Margin="28,10,28,11">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind DisplayName}" FontSize="30"
                                                   Foreground="{StaticResource AppTextPrimaryBrush}" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind ConsoleDisplayName}" FontSize="22"
                                                   Foreground="{StaticResource AppTextSecondaryBrush}" />
                                        </StackPanel>
                                        <!-- 右端の状態表示: インストール済み=青 / 未インストール=グレー -->
                                        <TextBlock Grid.Column="1" Text="{x:Bind StatusText, Mode=OneWay}" FontSize="28"
                                               Foreground="{x:Bind Installed, Mode=OneWay, Converter={StaticResource StatusTextBrush}}"
                                               VerticalAlignment="Center" Margin="24,0,0,0" />
                                    </Grid>
                                    <Rectangle Height="1" VerticalAlignment="Bottom" Fill="#FFCFCFCF" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <controls:HintBar Grid.Row="2" Margin="48,0,48,28" HorizontalAlignment="Stretch" ShowFooterFrame="True">
                        <controls:HintBar.Hints>
                            <controls:HintDefinition Key="DPad" Label="移動" />
                            <controls:HintDefinition Key="B" Label="もどる" />
                            <controls:HintDefinition Key="A" Label="決定" />
                        </controls:HintBar.Hints>
                    </controls:HintBar>
                </Grid>
            </Viewbox>
        </Grid>

        <!-- コア管理の全画面(2): コアモジュール詳細設定(旧「コア毎の設定」)。左にインストール済みの
             コアだけの一覧(領域CoreOptionsCoreList)、右に選んだコアのオプション一覧(領域CoreOptionsList。
             項目名+現在値の青文字)。表示するかどうかは、今の操作領域がこの2つのどちらかかどうかで決まる。
             cores/libretro.jsonの"options"が未設定のコアは「設定可能な項目がありません」の案内を出す。 -->
        <Grid x:Name="CoreDetailScreen" Background="{StaticResource AppBackgroundBrush}"
              Visibility="{x:Bind IsCoreDetailScreenVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <Viewbox Stretch="Uniform">
                <Grid Width="{StaticResource CanvasWidth}" Height="{StaticResource CanvasHeight}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="150" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="160,0,160,0">
                        <TextBlock Text="コアモジュール詳細設定" Style="{StaticResource SectionTitleTextStyle}"
                                   VerticalAlignment="Bottom" Margin="0,0,0,18" />
                        <Rectangle Height="2" VerticalAlignment="Bottom" Fill="{StaticResource AppTextPrimaryBrush}" Opacity="0.75" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="160,24,160,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="720" />
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 左: インストール済みのコアだけの一覧(領域CoreOptionsCoreList)。
                             選択中のコアは、右へフォーカスが移っても青い縦バー+青文字で残る。 -->
                        <ListView x:Name="CoreOptionsCoreListView" Grid.Column="0"
                              ItemsSource="{x:Bind InstalledCores}"
                              SelectionMode="Single"
                              SelectionChanged="CoreOptionsCoreListView_SelectionChanged"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              UseSystemFocusVisuals="False">
                            <ListView.Resources>
                                <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="Transparent" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedUnfocused" Color="Transparent" />
                                <SolidColorBrush x:Key="ListViewItemFocusBorderBrush" Color="Transparent" />
                                <SolidColorBrush x:Key="ListViewItemFocusSecondaryBorderBrush" Color="Transparent" />
                                <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="Transparent" />
                                <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPointerOverBrush" Color="Transparent" />
                                <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPressedBrush" Color="Transparent" />
                                <SolidColorBrush x:Key="ListViewItemSelectionIndicatorDisabledBrush" Color="Transparent" />
                            </ListView.Resources>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                      <Setter Property="FocusVisualPrimaryThickness" Value="0" />
                                      <Setter Property="FocusVisualSecondaryThickness" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:LibretroCoreListItem">
                                    <Grid MinHeight="104" Tapped="CoreOptionsCoreRow_Tapped">
                                        <Border Margin="0,0,0,1" CornerRadius="0" BorderThickness="4"
                                                Background="{x:Bind IsFocused, Mode=OneWay, Converter={StaticResource RowWhiteHighlight}}"
                                                BorderBrush="{x:Bind IsFocused, Mode=OneWay, Converter={StaticResource BoolToBrush}}" fs:FocusSlide.IsFocused="{x:Bind IsFocused, Mode=OneWay}" />
                                        <Rectangle Width="5" Margin="14,18,0,19" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                                   Fill="{StaticResource SwitchSelectedBlueBrush}"
                                                   Visibility="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                        <StackPanel Margin="40,10,16,11" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind DisplayName}" FontSize="28" TextWrapping="Wrap"
                                                   Foreground="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource SwitchBlueText}}" />
                                            <TextBlock Text="{x:Bind ConsoleDisplayName}" FontSize="22"
                                                   Foreground="{StaticResource AppTextSecondaryBrush}" />
                                        </StackPanel>
                                        <Rectangle Height="1" VerticalAlignment="Bottom" Fill="#FFCFCFCF" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- 右: 選択中コアのオプション一覧(領域CoreOptionsList)、または案内メッセージ。 -->
                        <Grid Grid.Column="2">
                            <TextBlock x:Name="NoOptionsPanel"
                                   Text="このコアにはまだ設定可能な項目がありません。&#x0a;(cores/libretro.jsonに項目が追加されると、ここに表示されます)"
                                   Style="{StaticResource EmptyStateTextStyle}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />

                            <ListView x:Name="CoreOptionsListView"
                                  ItemsSource="{x:Bind SelectedCoreOptions}"
                                  SelectionMode="Single"
                                  SelectionChanged="CoreOptionsListView_SelectionChanged"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  UseSystemFocusVisuals="False" Visibility="Collapsed">
                                  <ListView.Resources>
                                      <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                                      <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
                                      <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent" />
                                      <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="Transparent" />
                                      <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="Transparent" />
                                      <SolidColorBrush x:Key="ListViewItemBackgroundSelectedUnfocused" Color="Transparent" />
                                      <SolidColorBrush x:Key="ListViewItemFocusBorderBrush" Color="Transparent" />
                                      <SolidColorBrush x:Key="ListViewItemFocusSecondaryBorderBrush" Color="Transparent" />
                                      <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="Transparent" />
                                      <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPointerOverBrush" Color="Transparent" />
                                      <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPressedBrush" Color="Transparent" />
                                      <SolidColorBrush x:Key="ListViewItemSelectionIndicatorDisabledBrush" Color="Transparent" />
                                  </ListView.Resources>
                                  <ListView.ItemContainerStyle>
                                      <Style TargetType="ListViewItem">
                                      <Setter Property="FocusVisualPrimaryThickness" Value="0" />
                                      <Setter Property="FocusVisualSecondaryThickness" Value="0" />
                                          <Setter Property="Padding" Value="0" />
                                          <Setter Property="Margin" Value="0" />
                                          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                      </Style>
                                  </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:LibretroCoreOptionListItem">
                                        <Grid MinHeight="96" Tapped="CoreOptionRow_Tapped">
                                            <Border Margin="0,0,0,1" CornerRadius="0" BorderThickness="4"
                                                    Background="{x:Bind IsFocused, Mode=OneWay, Converter={StaticResource RowWhiteHighlight}}"
                                                    BorderBrush="{x:Bind IsFocused, Mode=OneWay, Converter={StaticResource BoolToBrush}}" fs:FocusSlide.IsFocused="{x:Bind IsFocused, Mode=OneWay}" />
                                            <Grid Margin="28,0,28,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{x:Bind Label}" FontSize="28"
                                                       Foreground="{StaticResource AppTextPrimaryBrush}"
                                                       VerticalAlignment="Center" TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind SelectedLabel, Mode=OneWay}" FontSize="28"
                                                       Foreground="{StaticResource SwitchSelectedBlueBrush}"
                                                       VerticalAlignment="Center" TextAlignment="Right" TextWrapping="Wrap"
                                                       MaxWidth="320" Margin="24,0,0,0" />
                                            </Grid>
                                            <Rectangle Height="1" VerticalAlignment="Bottom" Fill="#FFCFCFCF" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Grid>

                    <controls:HintBar Grid.Row="2" Margin="48,0,48,28" HorizontalAlignment="Stretch" ShowFooterFrame="True">
                        <controls:HintBar.Hints>
                            <controls:HintDefinition Key="DPad" Label="移動/値の変更" />
                            <controls:HintDefinition Key="B" Label="もどる" />
                            <controls:HintDefinition Key="A" Label="決定" />
                        </controls:HintBar.Hints>
                    </controls:HintBar>
                </Grid>
            </Viewbox>
        </Grid>

        <!-- ゲームフォルダ管理の全画面: ゲームフォルダの確認/削除。登録済みフォルダ(パス+コンソール名)の一覧。選んでAで確認ダイアログを出し、「削除する」で登録を解除する(フォルダ内のファイルは削除されない)。操作領域がFolderListのときだけ表示される。 -->
        <Grid x:Name="FolderScreen" Background="{StaticResource AppBackgroundBrush}"
              Visibility="{x:Bind IsFolderScreenVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <Viewbox Stretch="Uniform">
                <Grid Width="{StaticResource CanvasWidth}" Height="{StaticResource CanvasHeight}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="150" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="160,0,160,0">
                        <controls:SectionHeader x:Name="GameFolderManagementHeader" Title="ゲームフォルダの確認/削除"
                                                VerticalAlignment="Bottom" Margin="0,0,0,18" />
                        <Rectangle Height="2" VerticalAlignment="Bottom" Fill="{StaticResource AppTextPrimaryBrush}" Opacity="0.75" />
                    </Grid>

                    <ListView x:Name="FolderListView" Grid.Row="1" Margin="160,24,160,8"
                          ItemsSource="{x:Bind Folders}"
                          SelectionMode="Single"
                          SelectionChanged="FolderListView_SelectionChanged"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          UseSystemFocusVisuals="False">
                        <ListView.Resources>
                            <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
                            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent" />
                            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="Transparent" />
                            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedUnfocused" Color="Transparent" />
                            <SolidColorBrush x:Key="ListViewItemFocusBorderBrush" Color="Transparent" />
                            <SolidColorBrush x:Key="ListViewItemFocusSecondaryBorderBrush" Color="Transparent" />
                            <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="Transparent" />
                            <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPointerOverBrush" Color="Transparent" />
                            <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPressedBrush" Color="Transparent" />
                            <SolidColorBrush x:Key="ListViewItemSelectionIndicatorDisabledBrush" Color="Transparent" />
                        </ListView.Resources>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                      <Setter Property="FocusVisualPrimaryThickness" Value="0" />
                                      <Setter Property="FocusVisualSecondaryThickness" Value="0" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:RomFolderListItem">
                                <Grid MinHeight="104" Tapped="FolderRow_Tapped">
                                    <Border Margin="0,0,0,1" CornerRadius="0" BorderThickness="4"
                                            Background="{x:Bind IsFocused, Mode=OneWay, Converter={StaticResource RowWhiteHighlight}}"
                                            BorderBrush="{x:Bind IsFocused, Mode=OneWay, Converter={StaticResource BoolToBrush}}" fs:FocusSlide.IsFocused="{x:Bind IsFocused, Mode=OneWay}" />
                                    <Grid Margin="28,10,28,11">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind DisplayPath}" FontSize="28"
                                                   Foreground="{StaticResource AppTextPrimaryBrush}" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind ConsoleDisplayName}" FontSize="22"
                                                   Foreground="{StaticResource AppTextSecondaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{x:Bind StatusText, Mode=OneWay}" FontSize="28"
                                               Foreground="{StaticResource AppTextSecondaryBrush}"
                                               VerticalAlignment="Center" Margin="24,0,0,0" />
                                    </Grid>
                                    <Rectangle Height="1" VerticalAlignment="Bottom" Fill="#FFCFCFCF" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <controls:HintBar Grid.Row="2" Margin="48,0,48,28" HorizontalAlignment="Stretch" ShowFooterFrame="True">
                        <controls:HintBar.Hints>
                            <controls:HintDefinition Key="DPad" Label="移動" />
                            <controls:HintDefinition Key="B" Label="もどる" />
                            <controls:HintDefinition Key="A" Label="決定" />
                        </controls:HintBar.Hints>
                    </controls:HintBar>
                </Grid>
            </Viewbox>
        </Grid>

        <!-- ランチャー管理の全画面: ランチャーの編集/削除。Launchers.jsonのランチャー一覧(名前・コンソール名・起動方式)と、右端に使用中/未使用。選んでAで編集オーバーレイ(削除もそこで行う)を開く。操作領域がLauncherListのときだけ表示される。 -->
        <Grid x:Name="LauncherScreen" Background="{StaticResource AppBackgroundBrush}"
              Visibility="{x:Bind IsLauncherScreenVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <Viewbox Stretch="Uniform">
                <Grid Width="{StaticResource CanvasWidth}" Height="{StaticResource CanvasHeight}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="150" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="160,0,160,0">
                        <controls:SectionHeader x:Name="LauncherManagementHeader" Title="ランチャーの編集/削除"
                                                VerticalAlignment="Bottom" Margin="0,0,0,18" />
                        <Rectangle Height="2" VerticalAlignment="Bottom" Fill="{StaticResource AppTextPrimaryBrush}" Opacity="0.75" />
                    </Grid>

                    <ListView x:Name="LauncherListView" Grid.Row="1" Margin="160,24,160,8"
                          ItemsSource="{x:Bind Launchers}"
                          SelectionMode="Single"
                          SelectionChanged="LauncherListView_SelectionChanged"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          UseSystemFocusVisuals="False">
                        <ListView.Resources>
                            <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
                            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent" />
                            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="Transparent" />
                            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedUnfocused" Color="Transparent" />
                            <SolidColorBrush x:Key="ListViewItemFocusBorderBrush" Color="Transparent" />
                            <SolidColorBrush x:Key="ListViewItemFocusSecondaryBorderBrush" Color="Transparent" />
                            <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="Transparent" />
                            <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPointerOverBrush" Color="Transparent" />
                            <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPressedBrush" Color="Transparent" />
                            <SolidColorBrush x:Key="ListViewItemSelectionIndicatorDisabledBrush" Color="Transparent" />
                        </ListView.Resources>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                      <Setter Property="FocusVisualPrimaryThickness" Value="0" />
                                      <Setter Property="FocusVisualSecondaryThickness" Value="0" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:LauncherListItem">
                                <Grid MinHeight="104" Tapped="LauncherRow_Tapped">
                                    <Border Margin="0,0,0,1" CornerRadius="0" BorderThickness="4"
                                            Background="{x:Bind IsFocused, Mode=OneWay, Converter={StaticResource RowWhiteHighlight}}"
                                            BorderBrush="{x:Bind IsFocused, Mode=OneWay, Converter={StaticResource BoolToBrush}}" fs:FocusSlide.IsFocused="{x:Bind IsFocused, Mode=OneWay}" />
                                    <Grid Margin="28,10,28,11">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind DisplayName}" FontSize="30"
                                                   Foreground="{StaticResource AppTextPrimaryBrush}" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind ConsoleDisplayName}" FontSize="22"
                                                   Foreground="{StaticResource AppTextSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind DetailText}" FontSize="20"
                                                   Foreground="{StaticResource AppTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <!-- 右端の状態表示: 使用中=青 / 未使用=グレー -->
                                        <TextBlock Grid.Column="1" Text="{x:Bind InUseText}" FontSize="28"
                                               Foreground="{x:Bind IsInUse, Converter={StaticResource StatusTextBrush}}"
                                               VerticalAlignment="Center" Margin="24,0,0,0" />
                                    </Grid>
                                    <Rectangle Height="1" VerticalAlignment="Bottom" Fill="#FFCFCFCF" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <controls:HintBar Grid.Row="2" Margin="48,0,48,28" HorizontalAlignment="Stretch" ShowFooterFrame="True">
                        <controls:HintBar.Hints>
                            <controls:HintDefinition Key="DPad" Label="移動" />
                            <controls:HintDefinition Key="B" Label="もどる" />
                            <controls:HintDefinition Key="A" Label="決定" />
                        </controls:HintBar.Hints>
                    </controls:HintBar>
                </Grid>
            </Viewbox>
        </Grid>

        <!-- 対応コンソールの選択、および簡単な案内メッセージ(いずれもContentDialogの代替)。 -->
        <controls:GamepadListPickerOverlay x:Name="ListPickerOverlay" Visibility="Collapsed" />
        <!-- ゲームフォルダ追加用の、ゲームパッドで操作できるフォルダ選択。 -->
        <controls:FolderPickerOverlay x:Name="FolderChooser" Visibility="Collapsed" />

        <!-- 「地域」など、複数の選択肢から1つを選ぶ全画面の選択画面(共通部品)。 -->
        <controls:FullScreenChoiceOverlay x:Name="ChoiceOverlay" Visibility="Collapsed" />

        <!-- 「コンソール並び替え」「コレクション並び替え」の全画面の入れ替え画面。 -->
        <controls:ReorderOverlay x:Name="ReorderScreen" Visibility="Collapsed" />
        <controls:SystemItemsOrderOverlay x:Name="SystemOrderScreen" Visibility="Collapsed" />

        <!-- 「コンソール編集」: アイコンと起動方法の編集画面(コンソール選択画面と共通の部品)。 -->
        <controls:ConsoleEditOverlay x:Name="ConsoleEditor" Visibility="Collapsed" />

        <!-- 「システム項目の編集」: システム画面に表示する項目を、複数選ぶ全画面の選択画面。 -->
        <controls:MultiChoiceOverlay x:Name="SystemItemsPicker" Visibility="Collapsed" />

        <!-- インストール/アンインストールなど、実行前の確認ダイアログ(共通部品)。 -->
        <controls:ConfirmDialogOverlay x:Name="ConfirmOverlay" Visibility="Collapsed" />
        <controls:GamepadMessageOverlay x:Name="MessageOverlay" Visibility="Collapsed" />

        <!-- ランチャーの新規追加/編集/削除。 -->
        <controls:LauncherEditOverlay x:Name="LauncherEditor" Visibility="Collapsed" />
        <controls:CollectionEditOverlay x:Name="CollectionEditor" Visibility="Collapsed" />
        <controls:CollectionSelectOverlay x:Name="CollectionSelector" Visibility="Collapsed" />
    </Grid>
</Page>
