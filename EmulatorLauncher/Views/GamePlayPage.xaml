<Page
    x:Class="EmulatorLauncher.Views.GamePlayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:EmulatorLauncher.Converters"
    xmlns:controls="using:EmulatorLauncher.Controls"
    xmlns:models="using:EmulatorLauncher.Models">

    <Page.Resources>
        <conv:BoolToRowHighlightConverter x:Key="RowHighlight" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <!-- 中断メニュー: 選択行は「白い帯+赤い文字」(Switchの中断メニューと同じ)。 -->
        <conv:BoolToMenuHighlightConverter x:Key="MenuHighlight" />
        <conv:SelectedToMenuForegroundConverter x:Key="MenuForeground" />
        <conv:BoolToFilmstripBorderConverter x:Key="FilmstripBorder" />
    </Page.Resources>

    <!-- 通常画面(ConsoleSelectPage等)はMainWindow.xamlのGrid.Background(base_white.png)が
         素通しで見えているが、ゲーム中はplay_back.pngにしたい。RootGrid(1920x1080の論理
         キャンバス)だけに背景を指定すると、Viewboxが実ウィンドウへ均等縮小した際に余る
         レターボックス/ピラーボックス部分(RootGridの外側)はMainWindow側のbase_white.pngが
         透けて見えたままになってしまう。そのため、Viewboxのさらに外側であるPage自体に
         背景を指定し、ページ全体(余白部分も含めて)をplay_back.pngで覆う
         (MainWindow.xamlと同じImageBrush + Stretch="UniformToFill"のパターン)。 -->
    <Page.Background>
        <ImageBrush ImageSource="ms-appx:///Assets/play_back.png" Stretch="UniformToFill" />
    </Page.Background>

    <Grid>
    <Viewbox Stretch="Uniform">
        <Grid x:Name="RootGrid" Width="{StaticResource CanvasWidth}" Height="{StaticResource CanvasHeight}">
            <Grid.RowDefinitions>
                <!-- Row 0: エミュレータ画面エリア -->
                <RowDefinition Height="*" />
                <!-- Row 1: 通常時 下部ガイドバー。「操作説明表示」トグルがOFFの間は
                     GamePlayPage.xaml.csのApplyShowControlGuide()がHeightを0にし、
                     Row 0側のセルを画面全体まで広げる(中断メニュー背景の一時停止
                     スクリーンショット等、WinUIの通常のクリッピングに従う要素が
                     Row 0のセル境界で見切れないようにするため)。 -->
                <RowDefinition x:Name="BottomBarRowDefinition" Height="70" />
            </Grid.RowDefinitions>

            <!-- ========================================== -->
            <!-- 1. エミュレータ画面ホスト (Row 0)           -->
            <!-- ========================================== -->
            <!-- EmuHostContainer は行全体に広がる単一のGrid。EmuHost(ゲーム画面)は
             Center配置とし、コード側(ComputeAndSetEmuHostSize)でWidth/Heightを
             直接ピクセル値で設定することで、左右/上下の余白(黒帯)を作る。 -->
            <Grid x:Name="EmuHostContainer" Grid.Row="0">
                <!-- EmuHostはApplyEmuHostLayout()でライブ描画とまったく同じ位置・サイズ
                     (選択中の画面比率設定込み)に常時調整されている。MenuBackgroundImageを
                     その子要素にすることで、別途レイアウト計算をせずにライブ描画と
                     ピクセル単位で一致させる。Stretch="Fill"は、ライブ側がSDL_LOGICAL_
                     PRESENTATION_STRETCHでネイティブ解像度をこの箱いっぱいに引き伸ばして
                     いるのと同じ表示にするため。 -->
                <Border x:Name="EmuHost" Background="Black"
        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image x:Name="MenuBackgroundImage" Stretch="Fill" Opacity="0.5" />
                </Border>

                <!-- 起動/終了時の連結アニメーション用のカバー画像。ゲーム選択画面のカードから拡大して
                     ここへ着地し(起動)、終了時はここからカードへ縮んで戻る。通常は非表示。 -->
                <Image x:Name="LaunchCoverImage" Stretch="Uniform" Visibility="Collapsed" IsHitTestVisible="False" />

                <!-- 外部コマンド(Cemu等)で起動している間の案内。通常のlibretro起動では常に非表示。 -->
                <TextBlock x:Name="ExternalStatusText" Visibility="Collapsed"
                           Foreground="White" FontSize="40" TextAlignment="Center" TextWrapping="Wrap"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="80,0" />

                <!--
                <TextBlock x:Name="StatusText" Text="起動中..." Foreground="#AAAAAA" FontSize="16"
                       HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,0" />
                -->
            </Grid>

            <!-- ========================================== -->
            <!-- 2. 通常時 下部ガイドバー (Row 1)            -->
            <!-- ========================================== -->

            <!-- PlayHintBar: 「設定」→「操作説明表示」トグル(CoreSettings.ShowControlGuide)
                 でVisibilityを切り替える(GamePlayPage.xaml.csのApplyShowControlGuide参照)。
                 既定はVisible(トグルOFF時のみCollapsed)。
                 他の画面と同じ「暗い半透明の帯+白丸」(IsOverlay)で、画面右下隅へ寄せて表示する。 -->
            <controls:HintBar x:Name="PlayHintBar" Grid.Row="1" IsOverlay="True"
                              HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <controls:HintBar.Hints>
                    <controls:HintDefinition x:Name="MenuHint" Key="L2+R2" Label="中断メニュー(長押しで巻き戻し)" />
                    <controls:HintDefinition Key="A" Label="決定" />
                </controls:HintBar.Hints>
            </controls:HintBar>

            <!-- 早送り中の倍率表示(画面左下)。操作説明(PlayHintBar)と同じ帯の中に出すため、
                 「操作説明表示」がONの間だけ、早送り中(2倍以上)に表示する。
                 ゲーム画面上のSDL描画の倍率バッジ(SWレンダリング)とは別物で、そちらは変更しない。
                 見た目はPlayHintBarのオーバーレイ(暗い半透明の帯)を左右反転させたもの。 -->
            <Border x:Name="FastForwardLabelBar" Grid.Row="1" Visibility="Collapsed"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    Background="#D81C1C1C" CornerRadius="0,22,0,0" Padding="32,8,32,8">
                <TextBlock x:Name="FastForwardLabelText" Foreground="White"
                           FontSize="32" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Border>

            <!--
            <Grid x:Name="PlayHintBar" Grid.Row="1" Style="{StaticResource BottomBarStyle}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="20" Margin="16,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Background="White" CornerRadius="3" Padding="4,1" Height="18" VerticalAlignment="Center">
                            <TextBlock Text="ZL" FontSize="10" FontWeight="Bold" Foreground="Black" />
                        </Border>
                        <TextBlock Text="+" FontSize="11" VerticalAlignment="Center" Foreground="Black" />
                        <Border Background="White" CornerRadius="3" Padding="4,1" Height="18" VerticalAlignment="Center">
                            <TextBlock Text="ZR" FontSize="10" FontWeight="Bold" Foreground="Black" />
                        </Border>
                        <TextBlock Text="中断メニュー" Style="{StaticResource HintTextStyle}" FontSize="16" Foreground="White" />
                    </StackPanel>
                    <StackPanel x:Name="RewindHintPanel" Orientation="Horizontal" Spacing="6">
                        <Border Background="White" CornerRadius="3" Padding="4,1" Height="18" VerticalAlignment="Center">
                            <TextBlock Text="ZL+ZR" FontSize="10" FontWeight="Bold" Foreground="Black" />
                        </Border>
                        <TextBlock Text="長押しで巻き戻し" Style="{StaticResource HintTextStyle}" FontSize="16" Foreground="White" />
                    </StackPanel>
                </StackPanel>
            </Grid>
            -->

            <!-- ========================================== -->
            <!-- 3. 中断メニュー オーバーレイ (全行を覆う)   -->
            <!-- ========================================== -->
            <Grid x:Name="MenuOverlay" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed" Opacity="0">
                <Grid Background="Transparent">
                    <Border Background="{StaticResource MenuScrimBrush}" />
                </Grid>

                <!-- Switchの中断メニューと同じ構成: 左にメニュー項目(右寄せ。選択行は白い帯+赤い文字)、
                     縦の区切り線をはさんで右にセーブスロット/設定の枠。 -->
                <Grid Margin="0,70,0,90">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="660" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 左: メニュー項目 -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4" Margin="120,0,0,0">
                        <ItemsControl x:Name="MenuItemsControl" ItemsSource="{x:Bind MenuItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:PauseMenuItem">
                                    <!-- 選択の白い帯は文字とは別の要素にして、上下に動くとき帯だけが前の行から滑るようにする(HighlightSlide)。 -->
                                    <Grid>
                                        <Border Background="{x:Bind IsSelected, Converter={StaticResource MenuHighlight}, Mode=OneWay}" />
                                        <TextBlock Text="{x:Bind Text, Mode=OneWay}" HorizontalAlignment="Right" FontSize="32"
                                                   Foreground="{x:Bind IsSelected, Converter={StaticResource MenuForeground}, Mode=OneWay}"
                                                   Margin="16,14,96,14"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- 縦の区切り線 -->
                    <Border Grid.Column="1" Width="2" Background="White" Opacity="0.9" />

                    <!-- 右: セーブスロット一覧(「セーブ」「ロード」選択中に操作可能) -->
                    <Border Grid.Column="2" x:Name="SlotsPanel" VerticalAlignment="Center" HorizontalAlignment="Left"
                        Width="800" Margin="70,0,0,0" Visibility="Collapsed" >
                        <StackPanel Spacing="8">
                            <ItemsControl x:Name="SlotsItemsControl" ItemsSource="{x:Bind SaveSlots}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:SaveSlotInfo">
                                        <Border Margin="0,0,0,24" BorderBrush="White" BorderThickness="2">
                                          <!-- 選択の帯は別の要素にして、上下に動くとき前の行から滑らせる(HighlightSlide.SlideListRow)。 -->
                                          <Grid>
                                            <Border Tag="highlight"
                                                    Background="{x:Bind IsSelected, Converter={StaticResource MenuHighlight}, Mode=OneWay}" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="{StaticResource MediaPlaceholderBackgroundBrush}"
                                                        Width="{x:Bind ThumbnailWidth}" Height="{x:Bind ThumbnailHeight}"
                                                        Margin="2">
                                                    <Grid>
                                                        <Image Source="{x:Bind Thumbnail, Mode=OneWay}"
                                                           Visibility="{x:Bind HasThumbnail, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                                           Stretch="Fill" />
                                                        <TextBlock Text="{x:Bind ThumbnailText}" Foreground="White"
                                                               Visibility="{x:Bind HasThumbnail, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"
                                                               FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>

                                                <!-- ラベル+その下にセーブ日時(Switchの中断メニューと同じ)。日時が無い枠は日時行を出さない。 -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="40,0,0,0" Spacing="6">
                                                    <TextBlock Text="{x:Bind Label}" FontSize="30"
                                                           Foreground="{x:Bind IsSelected, Converter={StaticResource MenuForeground}, Mode=OneWay}" />
                                                    <TextBlock Text="{x:Bind DateText}" FontSize="26"
                                                           Visibility="{x:Bind HasDate, Converter={StaticResource BoolToVisibility}}"
                                                           Foreground="{x:Bind IsSelected, Converter={StaticResource MenuForeground}, Mode=OneWay}" />
                                                </StackPanel>
                                            </Grid>
                                          </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 右: 設定枠(「設定」選択中に操作可能。アスペクト比/画質など。
                         SlotsPanelと同じ列に重ねて置き、開いている方だけVisibleにする) -->
                    <Border Grid.Column="2" x:Name="SettingsPanel" VerticalAlignment="Center" HorizontalAlignment="Left"
                        Width="1100" Margin="70,0,0,0" Visibility="Collapsed" Padding="36,30"
                        Background="{StaticResource TranslucentPanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderTranslucentBrush}" BorderThickness="2">
                        <!-- 項目が多いコア(Model 3等)では枠の高さに収まらないため、
                             項目部分だけをScrollViewerに入れて、選択に合わせてスクロールする。 -->
                        <Grid RowSpacing="18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="設定" Foreground="White" FontSize="32" FontWeight="Bold" Margin="4,0,0,6" />
                            <ScrollViewer Grid.Row="1" x:Name="SettingsScrollViewer" VerticalScrollBarVisibility="Hidden"
                                          VerticalScrollMode="Enabled" HorizontalScrollMode="Disabled" IsTabStop="False">
                            <ItemsControl x:Name="SettingsItemsControl" ItemsSource="{x:Bind SettingsItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:SettingsMenuItem">
                                        <StackPanel>
                                            <Rectangle Height="2" Margin="0,10,0,16" Fill="White" Opacity="0.5"
                                                       Visibility="{x:Bind HasSeparatorAbove, Converter={StaticResource BoolToVisibility}}" />
                                            <!-- 選択の帯は別の要素にして、上下に動くとき前の行から滑らせる(HighlightSlide.SlideListRow)。 -->
                                            <Grid Margin="0,0,0,6">
                                                <Border Tag="highlight"
                                                    Background="{x:Bind IsSelected, Converter={StaticResource MenuHighlight}, Mode=OneWay}" />
                                                <TextBlock Text="{x:Bind DisplayText, Mode=OneWay}" FontSize="28" Margin="20,14"
                                                           Foreground="{x:Bind IsSelected, Converter={StaticResource MenuForeground}, Mode=OneWay}" />
                                            </Grid>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- 右: ディスク一覧(「ディスク入れ替え」にカーソルがある間に出し、決定でフォーカスして選ぶ) -->
                    <Border Grid.Column="2" x:Name="DiskPanel" VerticalAlignment="Center" HorizontalAlignment="Left"
                        Width="1100" Margin="70,0,0,0" Visibility="Collapsed" Padding="36,30"
                        Background="{StaticResource TranslucentPanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderTranslucentBrush}" BorderThickness="2">
                        <Grid RowSpacing="18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="ディスク入れ替え" Foreground="White" FontSize="32" FontWeight="Bold" Margin="4,0,0,6" />
                            <ScrollViewer Grid.Row="1" x:Name="DiskScrollViewer" MaxHeight="640" VerticalScrollBarVisibility="Hidden"
                                          VerticalScrollMode="Enabled" HorizontalScrollMode="Disabled" IsTabStop="False">
                                <ItemsControl x:Name="DiskItemsControl" ItemsSource="{x:Bind DiskItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:DiskMenuItem">
                                            <!-- 選択の帯は別の要素にして、上下に動くとき前の行から滑らせる(HighlightSlide.SlideListRow)。 -->
                                            <Grid Margin="0,0,0,6">
                                                <Border Tag="highlight"
                                                    Background="{x:Bind IsSelected, Converter={StaticResource MenuHighlight}, Mode=OneWay}" />
                                                <TextBlock Text="{x:Bind DisplayText}" FontSize="28" TextWrapping="Wrap" Margin="20,14"
                                                           Foreground="{x:Bind IsSelected, Converter={StaticResource MenuForeground}, Mode=OneWay}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- 右: 項目の説明(「つづける」「リセット」など、右側に枠を持たない項目にカーソルがある間だけ出す。見るだけ) -->
                    <Border Grid.Column="2" x:Name="InfoPanel" VerticalAlignment="Center" HorizontalAlignment="Left"
                        Width="800" Margin="70,0,0,0" Visibility="Collapsed" Padding="36,30">
                        <TextBlock x:Name="InfoText" Foreground="White" FontSize="30" TextWrapping="Wrap" LineHeight="44" />
                    </Border>

                    <!-- 右: 操作方法の枠(「操作方法の確認」にカーソルがある間、設定枠と同じ場所に出す。見るだけ) -->
                    <Border Grid.Column="2" x:Name="ControlsPanel" VerticalAlignment="Center" HorizontalAlignment="Left"
                        Width="1100" Height="700" Margin="70,0,0,0" Visibility="Collapsed" Padding="36,30"
                        Background="{StaticResource TranslucentPanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderTranslucentBrush}" BorderThickness="2">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="操作方法" Foreground="White" FontSize="32" FontWeight="Bold" Margin="4,0,0,6" />
                            <TextBlock Grid.Row="1" x:Name="ControlsHotkeyText" Foreground="#FFBDBDBD" FontSize="22" TextWrapping="Wrap" Margin="4,0,0,0" />
                            <Viewbox Grid.Row="2" x:Name="ControlsGuideBox" Stretch="Uniform" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- 下部ヒントバー(メニュー表示中): 画面右下隅の暗い半透明の帯。 -->
                <controls:HintBar IsOverlay="True" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <controls:HintBar.Hints>
                        <controls:HintDefinition Key="DPad" Label="操作" />
                        <controls:HintDefinition Key="B" Label="戻る" />
                        <controls:HintDefinition Key="A" Label="決定" />
                    </controls:HintBar.Hints>
                </controls:HintBar>
            </Grid>

            <!-- ========================================== -->
            <!-- 4. 巻き戻し オーバーレイ (ZL+ZR長押しで表示)  -->
            <!-- ========================================== -->
            <Grid x:Name="RewindOverlay" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed" Opacity="0">
                <Border Background="{StaticResource VeryStrongOverlayScrimBrush}" />

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 大きなプレビュー: Viewboxが利用可能領域へ自動でUniform拡縮してくれるため、
                         コード側はRewindPreviewBoxのWidth/Height「比」(=選択中の画面比率設定)を
                         合わせるだけでよい(絶対値そのものには意味がない)。
                         Switchの巻き戻し画面のように、枠や角丸は付けず、暗い背景の中央にそのまま置く。 -->
                    <Grid Grid.Row="0" Margin="80,50,80,30">
                        <Viewbox Stretch="Uniform">
                            <Border x:Name="RewindPreviewBox" Width="400" Height="300" Background="Black">
                                <Image x:Name="RewindPreviewImage" Stretch="Fill"
                                       Visibility="{x:Bind HasSelectedRewindFrame, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            </Border>
                        </Viewbox>
                        <TextBlock x:Name="RewindEmptyText" Text="巻き戻しデータがありません(起動直後、またはこのコアでは記録がまだありません)"
                                   Foreground="{StaticResource AppTextSecondaryBrush}" FontSize="28" TextWrapping="Wrap" TextAlignment="Center"
                                   Margin="60" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{x:Bind HasSelectedRewindFrame, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                    </Grid>

                    <!-- フィルムストリップ(←→で選択): 画面幅いっぱいの濃いグレーの帯。選択中のコマは白枠。
                         下のマージンは、右下のヒントバーを帯の外(黒い部分)へ出すための余白。 -->
                    <Border Grid.Row="1" Margin="0,0,0,84" Padding="0,26" Background="#FF454545">
                        <ScrollViewer x:Name="RewindFilmstripScroller"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                      HorizontalScrollMode="Enabled" Background="Transparent">
                            <ItemsControl x:Name="RewindItemsControl" ItemsSource="{x:Bind RewindFrames}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center" Padding="24,18" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:RewindFrameInfo">
                                        <Border Width="{x:Bind ThumbnailWidth}" Height="{x:Bind ThumbnailHeight}" BorderThickness="4"
                                                BorderBrush="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource FilmstripBorder}}"
                                                Background="{StaticResource FilmstripThumbnailBackgroundBrush}">
                                            <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="Fill" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- 下部ヒントバー(巻き戻し画面表示中): 画面右下隅の暗い半透明の帯。 -->
                <controls:HintBar IsOverlay="True" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <controls:HintBar.Hints>
                        <controls:HintDefinition Key="DPad" Label="選択" />
                        <controls:HintDefinition Key="B" Label="戻る" />
                        <controls:HintDefinition Key="A" Label="決定" />
                    </controls:HintBar.Hints>
                </controls:HintBar>
            </Grid>

        </Grid>
    </Viewbox>

    <!-- システム設定パネル(中断メニューの上に重ねる。右からスライド) -->
    <controls:SystemSettingsOverlay x:Name="SystemSettings" Visibility="Collapsed" />
    </Grid>
</Page>
