<Page
    x:Class="EmulatorLauncher.Views.CollectionGameSelectPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:EmulatorLauncher.Converters"
    xmlns:controls="using:EmulatorLauncher.Controls"
    xmlns:models="using:EmulatorLauncher.Models"
    xmlns:staggered="using:CommunityToolkit.WinUI.Controls"
    Background="Transparent">

    <!-- NOTE(要確認): xmlns:staggered は CommunityToolkit.WinUI.Controls (StaggeredPanelを含む
         パッケージ)を指している。プロジェクトへ追加したNuGetパッケージのバージョンによって
         実際の名前空間/アセンブリ名が異なる可能性があるため、ビルドエラーが出た場合は
         インストールしたパッケージのドキュメントに合わせてこのxmlnsを調整すること。 -->

    <Page.Resources>
        <conv:BoolToBrushConverter x:Key="BoolToBrush" />
        <conv:BoolToThicknessConverter x:Key="BoolToThickness" />
        <conv:HexToBrushConverter x:Key="HexToBrush" />
        <conv:StringToVisibilityConverter x:Key="StringToVisibility" />
        <conv:IconPathToImageSourceConverter x:Key="IconPathToImageSource" UseCache="True" />
        <conv:AspectRatioToStaggeredHeightConverter x:Key="AspectRatioToStaggeredHeight" />
        <conv:BoolToZIndexConverter x:Key="BoolToZIndex" />
    </Page.Resources>

    <!-- このページは1920x1080の固定キャンバスを前提にデザインされているため、
         実際のウィンドウサイズへはこのページ内のViewboxで一様スケーリングする
         (GameSelectPage/ConsoleSelectPageと同じ考え方)。 -->
    <!-- ルートGrid: Viewbox(ページ本体)の上に、詳細/ソートオーバーレイをページ全体を覆う形で重ねる。
         オーバーレイをViewboxの内側に置くと、暗幕がViewboxと一緒に縮小されてウィンドウの余白
         (レターボックス)部分がマスクされないため、あえて外に出している
         (中身のレイアウトは各オーバーレイが自前のViewboxで1920x1080キャンバスへ合わせる)。 -->
    <Grid>
        <Viewbox Stretch="Uniform">
            <Grid Width="{StaticResource CanvasWidth}" Height="{StaticResource CanvasHeight}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="72" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ゲーム一覧(コレクション専用): Nintendo Switch Onlineのレトロゲーム一覧のような
                     「詰めて並べる」見た目にするため、GridView(均等格子)ではなく
                     ItemsControl+StaggeredPanelを使う。

                     GameSelectPageの均等格子(GridView/ItemsWrapGrid)は、十字キーでの移動を
                     「選択インデックス ± 列数」という単純な算術で扱えることが前提になっている
                     (GamePad DPadUp/Down → index±_columns)。StaggeredPanelは列ごとにカードの
                     高さがバラバラになるため、その前提が成り立たない。そのため、このページでは
                     十字キー入力をインデックス算術ではなく、実際のレイアウト座標を見て空間的に
                     一番近い候補へ移動してくれるFocusManager.TryMoveFocus(コードビハインド側の
                     MoveFocus参照)へ置き換えている。

                     StaggeredPanelは(StaggeredLayoutと違って)仮想化しないプレーンなPanelなので、
                     ItemsControlと組み合わせるとコレクション内の全カードが常にUI要素として
                     実体化される。これにより、ItemsRepeater+StaggeredLayoutで懸念していた
                     「画面外の未実体化要素へTryMoveFocusが候補を見つけられない」という問題が
                     構造的に起きなくなる(そもそも画面外の要素も最初から存在しているため)。
                     副作用として、コレクションの件数が非常に多い場合は全カードぶんの
                     メモリ・描画コストがかかる(GameSelectPageのGridView仮想化とは違う特性)。
                     「コレクションは数も少ない」という前提に立っているので、数百件を超えるような
                     大きいコレクションを作る運用になった場合はこの前提を見直す必要がある。

                     FocusManager.TryMoveFocusでフォーカスが移動した際の画面内スクロールは、
                     ScrollViewer標準のBringIntoViewOnFocusChangeには任せず、明示的にOFFにした上で
                     コードビハインド側(GameCard_GotFocus)で手動でStartBringIntoViewを呼んでいる。
                     標準のBringIntoViewOnFocusChangeは「拡大前の素のButtonのレイアウト境界」だけを
                     基準に必要最小限のスクロールをするため、GameSelectPageのStartBringIntoViewで
                     直面したのと同じ問題(拡大分の余白まで届かずに最小限で止まってしまう)が起きる。
                     手動で呼ぶことで、GameSelectPageと同じくTargetRectを拡大分だけ一回り大きくできる。

                     また、RowSpacing/ColumnSpacingは、拡大(1.13倍)しても隣接カードと物理的に
                     重ならない余白を確保できる値にしている(AspectRatioToStaggeredHeightConverterの
                     MaxHeightRatio=2.5倍・列幅220pxから逆算した最大はみ出し量に安全マージンを
                     加えた値)。StaggeredPanelはサードパーティ製の独自Panelで、Canvas.ZIndexによる
                     Z順の引き上げ(ItemContainerStyle参照)が確実に効くかどうか確証が持てないため、
                     Z順に頼らず「そもそも重ならない」形で構造的に解決している。

                     上下の余白は、ScrollViewer.Paddingではなく実体のある空のBorder(スペーサー)を
                     スクロール可能なコンテンツ自身の一部として明示的に置く形にしている。
                     マウスでスクロールを物理的に最上部まで動かしても上端がクリップされたままだった
                     (=Paddingがスクロール可能な領域として機能していなかった)ことが確認されたため、
                     「Paddingで本当に余白が確保できているか」という曖昧さの余地が無いこの方式へ
                     切り替えた。左右の余白はItemsControl自身のMarginで確保している。 -->
                <ScrollViewer x:Name="GameScrollViewer"
                          Grid.Row="0" Grid.RowSpan="3" Margin="0"
                          BringIntoViewOnFocusChange="False"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- 上端スペーサー: CardScaleOverflowMargin(コードビハインド)と同じ高さ。
                             選択カードが1行目で拡大した際、上方向へのはみ出しがここへ収まる。 -->
                        <Border Height="96" />

                        <ItemsControl x:Name="GameItemsControl"
                                  Margin="32,0,32,0"
                                  ItemsSource="{x:Bind Games}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <staggered:StaggeredPanel HorizontalAlignment="Stretch"
                                                           DesiredColumnWidth="350" ColumnSpacing="3" RowSpacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <!-- StaggeredPanelの直接の子は、ItemsControlが各アイテムごとに自動生成する
                                 ContentPresenter(カードのButtonはその中身)。選択中カードを最前面に
                                 出すZIndexは、Button側ではなくこのContentPresenter側に付けないと
                                 StaggeredPanel上の実際の重なり順には反映されない。x:BindはStyleの
                                 Setterには書けないため、ここだけ古典的な{Binding}でRomFile.IsSelectedを
                                 直接見ている(ItemsControlが生成するコンテナのDataContextは自動的に
                                 対応するアイテムになるため、これで正しく拾える)。 -->
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.ZIndex" Value="0" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:RomFile">
                                    <!-- 素のBorderをIsTabStop=Trueでフォーカス対象にすると、既定の
                                     フォーカス矩形(UseSystemFocusVisuals相当)を消せるか未確認のため、
                                     ButtonStyles.xamlと同じ考え方(新しいクラスは作らず標準Buttonに
                                     Style/Resourcesを当てるだけ)で、標準ButtonでBorderカードを
                                     包む形にしている。Button既定の背景/枠線は透明へ上書きし、選択中の
                                     見た目(BorderBrush/BorderThickness)は既存カードと同じ仕組みを使う。

                                     Tag="{x:Bind}"でRomFile自身をButtonのTagへ入れておく。ItemsControlには
                                     ItemsRepeater.GetElementIndexのような「要素→インデックス」を引く
                                     専用APIが無いため、GotFocus/LostFocusではこのTagから直接RomFileを
                                     取り出す(GameSelectPageのDetailCollectionsチップと同じ考え方)。

                                     注意: ButtonのCornerRadiusは明示的に0にする(未指定にはしない)。
                                     WinUI3のControl.CornerRadiusは内部のContentPresenterへ丸角クリップ
                                     としてバインドされ、既定スタイルが{ThemeResource ControlCornerRadius}
                                     由来の非ゼロ値を暗黙に持っている可能性があるため、明示的に0にしないと
                                     このButton側のクリップが残ってしまう。このクリップはButton自身の
                                     (拡大しない)レイアウトサイズに固定されるため、中のBorder(拡大
                                     アニメーションの対象)がフォーカス時に1.13倍へ拡大すると、はみ出した
                                     分を切り取ってしまい、「枠は元のまま、中身だけ少し拡大して見える」
                                     という見た目の崩れの原因になっていた。丸角の見た目自体は内側のBorderの
                                     CornerRadiusだけで出しており、Border自身が拡大対象なのでクリップも
                                     一緒にスケールし、正しく見える。 -->
                                    <Button Width="350"
                                    Height="{x:Bind AspectRatio, Converter={StaticResource AspectRatioToStaggeredHeight}, ConverterParameter=350, Mode=OneWay}"
                                    Padding="0" Margin="0"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                    CornerRadius="0"
                                    IsTabStop="True"
                                    UseSystemFocusVisuals="False"
                                    Tag="{x:Bind}"
                                    Loaded="GameCard_Loaded"
                                    GotFocus="GameCard_GotFocus"
                                    LostFocus="GameCard_LostFocus"
                                    Click="GameCard_Click">

                                        <Button.Resources>
                                            <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />


                                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                                            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                                            <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                                            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                                            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                                        </Button.Resources>

                                        <Border CornerRadius="10"
                                        BorderBrush="{x:Bind IsSelected, Converter={StaticResource BoolToBrush}, Mode=OneWay}"
                                        BorderThickness="{x:Bind IsSelected, Converter={StaticResource BoolToThickness}, Mode=OneWay}">
                                            <Grid>
                                                <!-- フォールバック表示: アクセントカラー背景 + ゲーム名/発売年。
                                                 GameSelectPageのカードと同じ考え方。 -->
                                                <Border CornerRadius="8" Background="{x:Bind AccentColorHex, Converter={StaticResource HexToBrush}}" />
                                                <Border CornerRadius="8" Background="{StaticResource CardCaptionScrimBrush}" />

                                                <StackPanel VerticalAlignment="Bottom" Padding="14" Spacing="2">
                                                    <TextBlock Text="{x:Bind DisplayTitle, Mode=OneWay}" Foreground="White" FontSize="14"
                                                       FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Text="{x:Bind ReleaseYear}" Foreground="{StaticResource CardCaptionTextBrush}" FontSize="16" />
                                                </StackPanel>

                                                <Image Source="{x:Bind IconPath, Converter={StaticResource IconPathToImageSource}, Mode=OneWay}"
                                               Visibility="{x:Bind IconPath, Converter={StaticResource StringToVisibility}, Mode=OneWay}"
                                               Stretch="Fill"
                                               ImageFailed="GameIcon_ImageFailed" />
                                            </Grid>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 下端スペーサー: 上端と同じ考え方(最終行が拡大した際の下方向のはみ出し用)。 -->
                        <Border Height="84" />
                    </StackPanel>
                </ScrollViewer>

                <!-- ヘッダー: コレクション名。スクロール領域を画面いっぱい(Grid.RowSpan=3)に広げたため、
                     スクロール領域より後ろ(=手前に描画される位置)に置き、背景色→透明のグラデーション帯を
                     下に敷いて、潜り込むカードの上でも読めるようにしている。 -->
                <Border Grid.Row="0" Height="110" VerticalAlignment="Top" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop x:Name="HeaderFadeStop0" Color="#F0E8E8E8" Offset="0.0" />
                            <GradientStop x:Name="HeaderFadeStop1" Color="#D0E8E8E8" Offset="0.6" />
                            <GradientStop x:Name="HeaderFadeStop2" Color="#00E8E8E8" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Grid Grid.Row="0" Margin="32,12,32,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- マウス/タッチ用のボタン(前の画面/コンソールに戻る/並び替え)。マウスやタッチを使ったときだけ表示される。 -->
                    <controls:TouchNavButtons x:Name="TouchNav" Grid.Column="2" Margin="16,0,0,0" />

                    <!-- コレクションのアイコン(小)。コレクション名の前に表示する。
                         アイコン画像が無い/読み込めない場合は、アクセントカラーの背景+フォルダのグリフ。 -->
                    <Border x:Name="CollectionIconBorder" Grid.Column="0" Width="52" Height="52"
                            Margin="0,0,16,0" VerticalAlignment="Center">
                        <Grid>
                            <FontIcon x:Name="CollectionIconGlyph" Glyph="&#xE8B7;" FontSize="26" Foreground="White" Opacity="0.7"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                            <!-- アイコン画像はもともと角丸なので、切り抜きも背景も付けずそのまま表示する。 -->
                            <Image x:Name="CollectionIconImage" Stretch="Uniform"
                                   ImageFailed="CollectionIconImage_ImageFailed" />
                        </Grid>
                    </Border>

                    <TextBlock x:Name="CollectionNameText" Grid.Column="1"
                           Foreground="{StaticResource AppTextPrimaryBrush}"
                           FontSize="32" FontWeight="SemiBold"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Grid>


                <!-- 下部ヒントバー: GameSelectPageと同じく、画面右下隅へ暗い半透明の帯として重ねる。
                     上下のスペーサー(96/84)は、最初/最後の行がヘッダー・ヒントバーの下に
                     潜り込まないための余白。 -->
                <controls:HintBar x:Name="CollectionHintBar" Grid.Row="0" Grid.RowSpan="3" IsOverlay="True"
                                  HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <controls:HintBar.Hints>
                        <controls:HintDefinition Key="B" Label="もどる" />
                        <controls:HintDefinition Key="Y" Label="長押しでソート" />
                        <controls:HintDefinition Key="X" Label="詳細" />
                        <controls:HintDefinition Key="A" Label="決定" />
                    </controls:HintBar.Hints>
                </controls:HintBar>
            </Grid>
        </Viewbox>

        <!-- 詳細オーバーレイ(Xボタン)/ソートオーバーレイ(Y長押し): Controls/の共通UserControl -->
        <controls:GameDetailOverlay x:Name="DetailOverlay" Visibility="Collapsed" />
        <controls:SortOverlay x:Name="SortOverlay" Visibility="Collapsed" />
        <controls:SystemSettingsOverlay x:Name="SystemSettings" Visibility="Collapsed" />
    </Grid>
</Page>
